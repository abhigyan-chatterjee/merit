      "title": "Brute Force",
      "complexity": "Time: O(n * n!) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(n, flights, src, dst, k) {\n  if (src === dst) return 0;\n  if (src < 0 || src >= n || dst < 0 || dst >= n) return -1;\n  const adj = [];\n  for (let i = 0; i < n; i++) adj.push([]);\n  for (const f of flights) {\n    if (f[0] >= 0 && f[0] < n && f[1] >= 0 && f[1] < n) adj[f[0]].push([f[1], f[2]]);\n  }\n  const visited = new Array(n).fill(false);\n  let best = Infinity;\n  function dfs(city, edgesUsed, cost) {\n    if (cost >= best) return;\n    if (city === dst) { best = cost; return; }\n    if (edgesUsed === k + 1) return;\n    visited[city] = true;\n    for (const leg of adj[city]) {\n      if (!visited[leg[0]]) dfs(leg[0], edgesUsed + 1, cost + leg[1]);\n    }\n    visited[city] = false;\n  }\n  dfs(src, 0, 0);\n  return best === Infinity ? -1 : best;\n}",
      "isReference": false
