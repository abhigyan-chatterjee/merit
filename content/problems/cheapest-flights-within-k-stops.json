      "title": "Optimal",
      "complexity": "Time: O((k + 1) * flights.length) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(n, flights, src, dst, k) {\n  if (src === dst) return 0;\n  if (src < 0 || src >= n || dst < 0 || dst >= n) return -1;\n  const INF = Infinity;\n  let dist = new Array(n).fill(INF);\n  dist[src] = 0;\n  for (let step = 0; step <= k; step++) {\n    const next = dist.slice();\n    for (const f of flights) {\n      if (f[0] < 0 || f[0] >= n || f[1] < 0 || f[1] >= n) continue;\n      if (dist[f[0]] !== INF && dist[f[0]] + f[2] < next[f[1]]) {\n        next[f[1]] = dist[f[0]] + f[2];\n      }\n    }\n    dist = next;\n  }\n  return dist[dst] === INF ? -1 : dist[dst];\n}",
      "isReference": true
    }
