    {
      "title": "Brute Force",
      "complexity": "Time: O(times.length * queries.length) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(window, times, queries) {\n  const out = [];\n  for (let i = 0; i < queries.length; i++) {\n    const q = queries[i];\n    let hits = 0;\n    for (let j = 0; j < times.length; j++) {\n      if (times[j] <= q && times[j] > q - window) hits++;\n    }\n    out.push(hits);\n  }\n  return out;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(times.length log times.length + queries.length log times.length) | Space: O(times.length)",
      "language": "javascript",
      "code": "function solve(window, times, queries) {\n  const sorted = times.slice().sort((a, b) => a - b);\n  const lowerBound = (target) => {\n    let lo = 0;\n    let hi = sorted.length;\n    while (lo < hi) {\n      const mid = (lo + hi) >> 1;\n      if (sorted[mid] < target) lo = mid + 1;\n      else hi = mid;\n    }\n    return lo;\n  };\n  const out = [];\n  for (let i = 0; i < queries.length; i++) {\n    const q = queries[i];\n    out.push(lowerBound(q + 1) - lowerBound(q - window + 1));\n  }\n  return out;\n}",
      "isReference": true
    }
