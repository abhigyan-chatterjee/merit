      "title": "Brute Force",
      "complexity": "Time: O(n^2) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums, k, x) {\n  const n = nums.length;\n  const distance = (value) => Math.abs(value - x);\n  const precedes = (i, j) => {\n    const di = distance(nums[i]);\n    const dj = distance(nums[j]);\n    if (di !== dj) return di < dj;\n    if (nums[i] !== nums[j]) return nums[i] < nums[j];\n    return i < j;\n  };\n  const chosen = [];\n  for (let i = 0; i < n; i++) {\n    let rank = 0;\n    for (let j = 0; j < n; j++) {\n      if (j !== i && precedes(j, i)) rank++;\n    }\n    if (rank < k) chosen.push(nums[i]);\n  }\n  chosen.sort((a, b) => a - b);\n  return chosen;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n log n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums, k, x) {\n  const ordered = nums.slice().sort((a, b) => a - b);\n  let lo = 0;\n  let hi = ordered.length - k;\n  while (lo < hi) {\n    const mid = (lo + hi) >> 1;\n    if (x - ordered[mid] > ordered[mid + k] - x) lo = mid + 1;\n    else hi = mid;\n  }\n  return ordered.slice(lo, lo + k);\n}",
      "isReference": true
    }
