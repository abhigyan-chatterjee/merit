  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n * n log n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums) {\n  let total = 0;\n  for (let i = 0; i < nums.length; i++) {\n    const window = nums.slice(0, i + 1).sort((a, b) => a - b);\n    total += window[Math.floor((window.length - 1) / 2)];\n  }\n  return total;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n log n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums) {\n  const low = [];\n  const high = [];\n  function pushLow(v) {\n    low.push(v);\n    let i = low.length - 1;\n    while (i > 0) {\n      const p = (i - 1) >> 1;\n      if (low[p] >= low[i]) break;\n      const t = low[p];\n      low[p] = low[i];\n      low[i] = t;\n      i = p;\n    }\n  }\n  function popLow() {\n    const top = low[0];\n    const last = low.pop();\n    if (low.length > 0) {\n      low[0] = last;\n      let i = 0;\n      while (true) {\n        const l = 2 * i + 1;\n        const r = 2 * i + 2;\n        let m = i;\n        if (l < low.length && low[l] > low[m]) m = l;\n        if (r < low.length && low[r] > low[m]) m = r;\n        if (m === i) break;\n        const t = low[m];\n        low[m] = low[i];\n        low[i] = t;\n        i = m;\n      }\n    }\n    return top;\n  }\n  function pushHigh(v) {\n    high.push(v);\n    let i = high.length - 1;\n    while (i > 0) {\n      const p = (i - 1) >> 1;\n      if (high[p] <= high[i]) break;\n      const t = high[p];\n      high[p] = high[i];\n      high[i] = t;\n      i = p;\n    }\n  }\n  function popHigh() {\n    const top = high[0];\n    const last = high.pop();\n    if (high.length > 0) {\n      high[0] = last;\n      let i = 0;\n      while (true) {\n        const l = 2 * i + 1;\n        const r = 2 * i + 2;\n        let m = i;\n        if (l < high.length && high[l] < high[m]) m = l;\n        if (r < high.length && high[r] < high[m]) m = r;\n        if (m === i) break;\n        const t = high[m];\n        high[m] = high[i];\n        high[i] = t;\n        i = m;\n      }\n    }\n    return top;\n  }\n  let total = 0;\n  for (const x of nums) {\n    if (low.length === 0 || x <= low[0]) pushLow(x);\n    else pushHigh(x);\n    if (low.length > high.length + 1) pushHigh(popLow());\n    else if (high.length > low.length) pushLow(popHigh());\n    total += low[0];\n  }\n  return total;\n}",
      "isReference": true
    }
  ],
