    {
      "title": "Optimal",
      "complexity": "Time: O(ops.length) | Space: O(capacity)",
      "language": "javascript",
      "code": "function solve(capacity, ops) {\n  const ring = new Array(capacity).fill(0);\n  let head = 0;\n  let size = 0;\n  const out = [];\n  for (let i = 0; i < ops.length; i++) {\n    const c = ops[i];\n    if (c > 0) {\n      if (size < capacity) {\n        ring[(head + size) % capacity] = c;\n        size++;\n        out.push(1);\n      } else out.push(0);\n    } else if (c === 0) {\n      if (size === 0) out.push(-1);\n      else {\n        const v = ring[head];\n        head = (head + 1) % capacity;\n        size--;\n        out.push(v);\n      }\n    } else if (c === -1) {\n      out.push(size === 0 ? -1 : ring[head]);\n    } else if (c === -2) {\n      out.push(size === 0 ? -1 : ring[(head + size - 1) % capacity]);\n    } else if (c === -3) {\n      out.push(size === 0 ? 1 : 0);\n    } else if (c === -4) {\n      out.push(size === capacity ? 1 : 0);\n    } else {\n      out.push(size);\n    }\n  }\n  return out;\n}",
      "isReference": true
    }
