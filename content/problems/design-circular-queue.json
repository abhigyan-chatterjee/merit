    {
      "title": "Brute Force",
      "complexity": "Time: O(ops.length * capacity) | Space: O(capacity)",
      "language": "javascript",
      "code": "function solve(capacity, ops) {\n  const store = [];\n  const out = [];\n  for (let i = 0; i < ops.length; i++) {\n    const c = ops[i];\n    if (c > 0) {\n      if (store.length < capacity) { store.push(c); out.push(1); }\n      else out.push(0);\n    } else if (c === 0) {\n      out.push(store.length === 0 ? -1 : store.shift());\n    } else if (c === -1) {\n      out.push(store.length === 0 ? -1 : store[0]);\n    } else if (c === -2) {\n      out.push(store.length === 0 ? -1 : store[store.length - 1]);\n    } else if (c === -3) {\n      out.push(store.length === 0 ? 1 : 0);\n    } else if (c === -4) {\n      out.push(store.length === capacity ? 1 : 0);\n    } else {\n      out.push(store.length);\n    }\n  }\n  return out;\n}",
      "isReference": false
