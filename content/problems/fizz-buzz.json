      "code": "function solve(n) {\n  const result = [];\n  for (let value = 1; value <= n; value++) {\n    if (value % 15 === 0) result.push(\"FizzBuzz\");\n    else if (value % 3 === 0) result.push(\"Fizz\");\n    else if (value % 5 === 0) result.push(\"Buzz\");\n    else result.push(String(value));\n  }\n  return result;\n}",
