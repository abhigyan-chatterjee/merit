      "language": "javascript",
      "code": "function solve(n) {\n  const result = [];\n  for (let value = 1; value <= n; value++) {\n    let restOfThree = value;\n    while (restOfThree >= 3) restOfThree -= 3;\n    let restOfFive = value;\n    while (restOfFive >= 5) restOfFive -= 5;\n    if (restOfThree === 0 && restOfFive === 0) result.push(\"FizzBuzz\");\n    else if (restOfThree === 0) result.push(\"Fizz\");\n    else if (restOfFive === 0) result.push(\"Buzz\");\n    else result.push(String(value));\n  }\n  return result;\n}",
      "isReference": false
    },
