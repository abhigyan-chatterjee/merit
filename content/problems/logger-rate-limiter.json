      "language": "javascript",
      "code": "function solve(timestamps, messages) {\n  const n = Math.min(timestamps.length, messages.length);\n  const printed = [];\n  const out = [];\n  for (let i = 0; i < n; i++) {\n    const ts = timestamps[i];\n    const msg = messages[i];\n    let best = null;\n    for (let k = 0; k < printed.length; k++) {\n      if (printed[k][1] === msg && (best === null || printed[k][0] > best)) {\n        best = printed[k][0];\n      }\n    }\n    if (best === null || ts - best >= 10) {\n      out.push(1);\n      printed.push([ts, msg]);\n    } else {\n      out.push(0);\n    }\n  }\n  return out;\n}",
