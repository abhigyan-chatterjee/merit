      "language": "javascript",
      "code": "function solve(timestamps, messages) {\n  const n = Math.min(timestamps.length, messages.length);\n  const last = new Map();\n  const out = [];\n  for (let i = 0; i < n; i++) {\n    const ts = timestamps[i];\n    const msg = messages[i];\n    if (!last.has(msg)) {\n      out.push(1);\n      last.set(msg, ts);\n    } else {\n      const prev = last.get(msg);\n      if (ts - prev >= 10) {\n        out.push(1);\n        last.set(msg, prev > ts ? prev : ts);\n      } else {\n        out.push(0);\n      }\n    }\n  }\n  return out;\n}",
