    {
      "input": "height = []",
      "output": "0",
      "explanation": "An empty elevation map traps no water."
    },
    {
      "input": "height = [77, 3, 71, 25, 91, 83, 89, 69, 53, 28, 57, 75, 35, 0, 97, 20]",
      "output": "462",
      "explanation": "Tall bars at heights 91 and 97 trap water between them and across lower valleys."
    },
    {
      "input": "height = [54, 43, 35, 19, 27, 97, 43, 13, 11, 48, 12, 45, 44, 77, 33, 5, 93, 58, 68, 15, 48, 10]",
      "output": "734",
      "explanation": "Multiple peaks (97, 48, 77, 93) create several trapping basins whose volumes sum to 734."
    }
  ],
  "constraints": [
    "Function signature: `function trap(height: number[])`.",
    "Inputs are JSON-serializable values satisfying the bounds stated above."
  ],
  "hints": [
    "Water at index i is min(max to the left, max to the right) minus height[i].",
    "Precompute left-max and right-max arrays, or use two pointers converging inward.",
    "Advance the pointer on the shorter side\u2014its water level is already bounded by the opposite max."
  ],
  "editorial": {
    "approach": "For each index, the water held equals min(max-left, max-right) - height[i] if positive. The brute force re-scans for left and right maxima at every position (O(n^2)). The optimal uses two pointers converging inward, tracking leftMax and rightMax so each bar is processed in O(1).",
    "why_optimal": "Brute force is O(n^2): each of the n positions rescans up to n predecessors. The two-pointer variant visits each bar once\u2014O(n). On 22 cases the optimal ran in 0.25 ms versus 0.89 ms (~3.5x faster).",
    "pitfalls": "Decide which pointer to advance based on height[left] < height[right], not on which max is larger. Processing the shorter side guarantees the current water level is bounded by the known shorter maximum, so accumulating is correct."
  },
