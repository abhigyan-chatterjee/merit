  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2 * d) | Space: O(n * d)",
      "language": "javascript",
      "code": "function solve(nums) {\n  const strs = nums.map((v) => String(v));\n  let best = 0;\n  for (let i = 0; i < strs.length; i++) {\n    for (let j = i + 1; j < strs.length; j++) {\n      const a = strs[i];\n      const b = strs[j];\n      const limit = Math.min(a.length, b.length);\n      let l = 0;\n      while (l < limit && a[l] === b[l]) l++;\n      if (l > best) best = l;\n    }\n  }\n  return best;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n * d) | Space: O(n * d)",
      "language": "javascript",
      "code": "function solve(nums) {\n  const seen = new Set();\n  let best = 0;\n  for (const num of nums) {\n    const s = String(num);\n    for (let len = 1; len <= s.length; len++) {\n      const prefix = s.slice(0, len);\n      if (seen.has(prefix)) {\n        if (len > best) best = len;\n      } else {\n        seen.add(prefix);\n      }\n    }\n  }\n  return best;\n}",
      "isReference": true
    }
