      "title": "Brute Force",
      "complexity": "Time: O(V^2 + E) | Space: O(V + E)",
      "language": "javascript",
      "code": "function solve(words) {\n  const letters = new Set();\n  for (const w of words) {\n    for (const ch of w) letters.add(ch);\n  }\n  const adj = new Map();\n  const indeg = new Map();\n  for (const ch of letters) {\n    adj.set(ch, new Set());\n    indeg.set(ch, 0);\n  }\n  for (let i = 0; i + 1 < words.length; i++) {\n    const a = words[i];\n    const b = words[i + 1];\n    const m = Math.min(a.length, b.length);\n    let j = 0;\n    while (j < m && a[j] === b[j]) j++;\n    if (j === m) {\n      if (a.length > b.length) return '';\n      continue;\n    }\n    const u = a[j];\n    const v = b[j];\n    if (!adj.get(u).has(v)) {\n      adj.get(u).add(v);\n      indeg.set(v, indeg.get(v) + 1);\n    }\n  }\n  const order = Array.from(letters).sort();\n  const used = new Set();\n  let out = '';\n  for (let step = 0; step < order.length; step++) {\n    let pick = null;\n    for (const ch of order) {\n      if (!used.has(ch) && indeg.get(ch) === 0) {\n        pick = ch;\n        break;\n      }\n    }\n    if (pick === null) return '';\n    used.add(pick);\n    out += pick;\n    for (const nb of adj.get(pick)) {\n      indeg.set(nb, indeg.get(nb) - 1);\n    }\n  }\n  return out;\n}",
      "isReference": false
