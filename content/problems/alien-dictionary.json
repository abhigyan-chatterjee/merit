      "title": "Optimal",
      "complexity": "Time: O((V + E) log V) | Space: O(V + E)",
      "language": "javascript",
      "code": "function solve(words) {\n  const letters = new Set();\n  for (const w of words) {\n    for (const ch of w) letters.add(ch);\n  }\n  const adj = new Map();\n  const indeg = new Map();\n  for (const ch of letters) {\n    adj.set(ch, new Set());\n    indeg.set(ch, 0);\n  }\n  for (let i = 0; i + 1 < words.length; i++) {\n    const a = words[i];\n    const b = words[i + 1];\n    const m = Math.min(a.length, b.length);\n    let j = 0;\n    while (j < m && a[j] === b[j]) j++;\n    if (j === m) {\n      if (a.length > b.length) return '';\n      continue;\n    }\n    const u = a[j];\n    const v = b[j];\n    if (!adj.get(u).has(v)) {\n      adj.get(u).add(v);\n      indeg.set(v, indeg.get(v) + 1);\n    }\n  }\n  const heap = [];\n  const swap = (i, j) => {\n    const t = heap[i];\n    heap[i] = heap[j];\n    heap[j] = t;\n  };\n  const push = (ch) => {\n    heap.push(ch);\n    let i = heap.length - 1;\n    while (i > 0) {\n      const p = (i - 1) >> 1;\n      if (heap[p] <= heap[i]) break;\n      swap(p, i);\n      i = p;\n    }\n  };\n  const pop = () => {\n    const top = heap[0];\n    const last = heap.pop();\n    if (heap.length > 0) {\n      heap[0] = last;\n      let i = 0;\n      while (true) {\n        const l = 2 * i + 1;\n        const r = l + 1;\n        let m = i;\n        if (l < heap.length && heap[l] < heap[m]) m = l;\n        if (r < heap.length && heap[r] < heap[m]) m = r;\n        if (m === i) break;\n        swap(m, i);\n        i = m;\n      }\n    }\n    return top;\n  };\n  for (const ch of letters) {\n    if (indeg.get(ch) === 0) push(ch);\n  }\n  let out = '';\n  while (heap.length > 0) {\n    const ch = pop();\n    out += ch;\n    for (const nb of adj.get(ch)) {\n      const d = indeg.get(nb) - 1;\n      indeg.set(nb, d);\n      if (d === 0) push(nb);\n    }\n  }\n  return out.length === letters.size ? out : '';\n}",
