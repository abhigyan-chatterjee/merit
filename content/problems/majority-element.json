  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n²) | Space: O(1)",
      "language": "javascript",
      "code": "function majorityElement(nums) {\n  for (let i = 0; i < nums.length; i++) {\n    let count = 0;\n    for (let j = 0; j < nums.length; j++) {\n      if (nums[j] === nums[i]) count++;\n    }\n    if (count > Math.floor(nums.length / 2)) return nums[i];\n  }\n  let candidate = nums[0], count = 0;\n  for (let i = 0; i < nums.length; i++) {\n    if (count === 0) candidate = nums[i];\n    count += (nums[i] === candidate) ? 1 : -1;\n  }\n  return candidate;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "javascript",
      "code": "function majorityElement(nums) {\n  let candidate = nums[0], count = 0;\n  for (let i = 0; i < nums.length; i++) {\n    if (count === 0) candidate = nums[i];\n    count += (nums[i] === candidate) ? 1 : -1;\n  }\n  return candidate;\n}",
      "isReference": true
    },
    {
      "title": "Brute Force",
      "complexity": "Time: O(n²) | Space: O(1)",
      "language": "python",
      "code": "def majorityElement(nums):\n    for i in range(len(nums)):\n        count = 0\n        for j in range(len(nums)):\n            if nums[j] == nums[i]:\n                count += 1\n        if count > len(nums) // 2:\n            return nums[i]\n    candidate = nums[0]\n    count = 0\n    for num in nums:\n        if count == 0:\n            candidate = num\n        count += 1 if num == candidate else -1\n    return candidate\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(1)",
