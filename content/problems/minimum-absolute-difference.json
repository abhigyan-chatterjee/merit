  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums) {\n  const n = nums.length;\n  if (n < 2) return [];\n  let best = Infinity;\n  for (let i = 0; i < n; i++) {\n    for (let j = i + 1; j < n; j++) {\n      const d = Math.abs(nums[i] - nums[j]);\n      if (d < best) best = d;\n    }\n  }\n  const seen = new Set();\n  const pairs = [];\n  for (let i = 0; i < n; i++) {\n    for (let j = i + 1; j < n; j++) {\n      if (Math.abs(nums[i] - nums[j]) !== best) continue;\n      const a = nums[i] < nums[j] ? nums[i] : nums[j];\n      const b = nums[i] < nums[j] ? nums[j] : nums[i];\n      const key = a + ',' + b;\n      if (!seen.has(key)) {\n        seen.add(key);\n        pairs.push([a, b]);\n      }\n    }\n  }\n  pairs.sort((p, q) => (p[0] - q[0]) || (p[1] - q[1]));\n  return pairs;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n log n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums) {\n  if (nums.length < 2) return [];\n  const a = nums.slice().sort((x, y) => x - y);\n  let best = Infinity;\n  for (let i = 1; i < a.length; i++) {\n    const d = a[i] - a[i - 1];\n    if (d < best) best = d;\n  }\n  const res = [];\n  for (let i = 1; i < a.length; i++) {\n    if (a[i] - a[i - 1] === best) {\n      const pair = [a[i - 1], a[i]];\n      const m = res.length;\n      if (m === 0 || res[m - 1][0] !== pair[0] || res[m - 1][1] !== pair[1]) {\n        res.push(pair);\n      }\n    }\n  }\n  return res;\n}",
      "isReference": true
    }
  ],
