  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(nums) {\n  let best = null;\n  for (let i = 0; i < nums.length; i++) {\n    for (let j = i + 1; j < nums.length; j++) {\n      if (nums[j] === nums[i]) {\n        if (best === null || nums[i] < best) best = nums[i];\n        break;\n      }\n    }\n  }\n  return best === null ? -1 : best;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums) {\n  const seen = new Set();\n  let best = null;\n  for (const x of nums) {\n    if (seen.has(x)) {\n      if (best === null || x < best) best = x;\n    } else {\n      seen.add(x);\n    }\n  }\n  return best === null ? -1 : best;\n}",
      "isReference": true
    }
