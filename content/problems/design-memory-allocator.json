  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(ops.length * memory^2) | Space: O(memory)",
      "language": "javascript",
      "code": "function solve(memory, ops) {\n  const owner = new Array(memory).fill(0);\n  const starts = new Map();\n  const sizes = new Map();\n  const out = [];\n  for (let i = 0; i < ops.length; i++) {\n    const c = ops[i];\n    if (c > 0) {\n      const size = c;\n      let placed = -1;\n      for (let s = 0; s + size <= memory; s++) {\n        let ok = true;\n        for (let j = s; j < s + size; j++) {\n          if (owner[j] !== 0) { ok = false; break; }\n        }\n        if (ok) { placed = s; break; }\n      }\n      if (placed !== -1) {\n        const label = i + 1;\n        for (let j = placed; j < placed + size; j++) owner[j] = label;\n        starts.set(label, placed);\n        sizes.set(label, size);\n      }\n      out.push(placed);\n    } else if (c < 0) {\n      const label = -c;\n      let freed = 0;\n      if (starts.has(label)) {\n        const s = starts.get(label);\n        const size = sizes.get(label);\n        for (let j = s; j < s + size; j++) owner[j] = 0;\n        starts.delete(label);\n        sizes.delete(label);\n        freed = size;\n      }\n      out.push(freed);\n    } else {\n      out.push(0);\n    }\n  }\n  return out;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(ops.length * memory) | Space: O(memory)",
      "language": "javascript",
      "code": "function solve(memory, ops) {\n  const blocks = new Map();\n  const free = [[0, memory]];\n  const out = [];\n  for (let i = 0; i < ops.length; i++) {\n    const c = ops[i];\n    if (c > 0) {\n      const size = c;\n      let placed = -1;\n      for (let k = 0; k < free.length; k++) {\n        const span = free[k][1] - free[k][0];\n        if (span >= size) {\n          placed = free[k][0];\n          if (span === size) free.splice(k, 1);\n          else free[k][0] += size;\n          break;\n        }\n      }\n      if (placed !== -1) blocks.set(i + 1, [placed, size]);\n      out.push(placed);\n    } else if (c < 0) {\n      const label = -c;\n      const block = blocks.get(label);\n      if (block === undefined) {\n        out.push(0);\n        continue;\n      }\n      const start = block[0];\n      const size = block[1];\n      blocks.delete(label);\n      let k = 0;\n      while (k < free.length && free[k][0] < start) k++;\n      let lo = start;\n      let hi = start + size;\n      if (k > 0 && free[k - 1][1] === lo) {\n        lo = free[k - 1][0];\n        free.splice(k - 1, 1);\n        k--;\n      }\n      if (k < free.length && free[k][0] === hi) {\n        hi = free[k][1];\n        free.splice(k, 1);\n      }\n      free.splice(k, 0, [lo, hi]);\n      out.push(size);\n    } else {\n      out.push(0);\n    }\n  }\n  return out;\n}",
      "isReference": true
    }
