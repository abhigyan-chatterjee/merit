  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n^2) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(nums, limit) {\n  const n = nums.length;\n  if (n === 0) return 0;\n  let best = 1;\n  for (let i = 0; i < n; i++) {\n    let lo = nums[i];\n    let hi = nums[i];\n    for (let j = i; j < n; j++) {\n      if (nums[j] < lo) lo = nums[j];\n      if (nums[j] > hi) hi = nums[j];\n      if (hi - lo <= limit && j - i + 1 > best) best = j - i + 1;\n    }\n  }\n  return best;\n}\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums, limit) {\n  const n = nums.length;\n  if (n === 0) return 0;\n  const maxq = [];\n  const minq = [];\n  let mh = 0;\n  let nh = 0;\n  let left = 0;\n  let best = 0;\n  for (let right = 0; right < n; right++) {\n    while (maxq.length > mh && nums[maxq[maxq.length - 1]] <= nums[right]) maxq.pop();\n    maxq.push(right);\n    while (minq.length > nh && nums[minq[minq.length - 1]] >= nums[right]) minq.pop();\n    minq.push(right);\n    while (nums[maxq[mh]] - nums[minq[nh]] > limit) {\n      if (maxq[mh] === left) mh++;\n      if (minq[nh] === left) nh++;\n      left++;\n    }\n    if (right - left + 1 > best) best = right - left + 1;\n  }\n  return best;\n}\n",
      "isReference": true
    }
