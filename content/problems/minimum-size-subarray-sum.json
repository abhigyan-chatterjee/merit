  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(nums, target) {\n  var n = nums.length;\n  var best = n + 1;\n  for (var i = 0; i < n; i++) {\n    var sum = 0;\n    for (var j = i; j < n; j++) {\n      sum += nums[j];\n      if (sum >= target && j - i + 1 < best) best = j - i + 1;\n    }\n  }\n  return best > n ? 0 : best;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(nums, target) {\n  var n = nums.length;\n  var left = 0;\n  var sum = 0;\n  var best = n + 1;\n  for (var right = 0; right < n; right++) {\n    sum += nums[right];\n    while (sum >= target && left <= right) {\n      var width = right - left + 1;\n      if (width < best) best = width;\n      sum -= nums[left];\n      left++;\n    }\n  }\n  return best > n ? 0 : best;\n}",
      "isReference": true
    }
