  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(1)",
      "language": "javascript",
      "code": "function longestOnes(nums, k) {\n  let best = 0;\n  const n = nums.length;\n\n  for (let i = 0; i < n; i++) {\n    let zeroCount = 0;\n    for (let j = i; j < n; j++) {\n      if (nums[j] === 0) {\n        zeroCount++;\n      }\n      if (zeroCount <= k) {\n        const currentLength = j - i + 1;\n        if (currentLength > best) {\n          best = currentLength;\n        }\n      } else {\n        break;\n      }\n    }\n  }\n\n  return best;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "javascript",
      "code": "function longestOnes(nums, k) {\n  let left = 0;\n  let zeroCount = 0;\n  let best = 0;\n\n  for (let right = 0; right < nums.length; right++) {\n    if (nums[right] === 0) {\n      zeroCount++;\n    }\n\n    while (zeroCount > k) {\n      if (nums[left] === 0) {\n        zeroCount--;\n      }\n      left++;\n    }\n\n    const currentLength = right - left + 1;\n    if (currentLength > best) {\n      best = currentLength;\n    }\n  }\n\n  return best;\n}",
      "isReference": true
    },
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(1)",
      "language": "python",
      "code": "def longestOnes(nums, k):\n    best = 0\n    n = len(nums)\n    for i in range(n):\n        zeroCount = 0\n        for j in range(i, n):\n            if nums[j] == 0:\n                zeroCount += 1\n            if zeroCount <= k:\n                currentLength = j - i + 1\n                if currentLength > best:\n                    best = currentLength\n            else:\n                break\n    return best\n",
      "isReference": false
