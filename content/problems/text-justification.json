      "code": "function solve(words, maxWidth) {\n  var src = (words !== null && words !== undefined && typeof words === 'object' && typeof words.length === 'number') ? words : [];\n  var n = src.length;\n\n  function toWord(w) {\n    if (typeof w === 'string') return w;\n    if (w === null || w === undefined) return '';\n    if (typeof w === 'boolean') return w ? 'true' : 'false';\n    return String(w);\n  }\n\n  var ws = [];\n  for (var i0 = 0; i0 < n; i0++) ws.push(toWord(src[i0]));\n\n  var W = 0;\n  if (typeof maxWidth === 'boolean') W = maxWidth ? 1 : 0;\n  else if (typeof maxWidth === 'number' && isFinite(maxWidth)) W = Math.trunc(maxWidth);\n  else if (typeof maxWidth === 'string' && maxWidth.trim() !== '' && isFinite(Number(maxWidth))) W = Math.trunc(Number(maxWidth));\n\n  function assemble(lo, hi, width, isLast) {\n    var count = hi - lo;\n    var line = ws[lo];\n    if (count === 1 || isLast) {\n      for (var t = lo + 1; t < hi; t++) line += ' ' + ws[t];\n      var pad = W - line.length;\n      if (pad > 0) line += ' '.repeat(pad);\n      return line;\n    }\n    var spaces = W - width;\n    var gaps = count - 1;\n    var padArr = [];\n    for (var g0 = 0; g0 < gaps; g0++) padArr.push(1);\n    var remaining = spaces - gaps;\n    var at = 0;\n    while (remaining > 0) {\n      padArr[at % gaps] += 1;\n      remaining--;\n      at++;\n    }\n    for (var g1 = 0; g1 < gaps; g1++) line += ' '.repeat(padArr[g1]) + ws[lo + 1 + g1];\n    return line;\n  }\n\n  var res = [];\n  var i = 0;\n  while (i < n) {\n    var j = i;\n    for (var cand = n - 1; cand > i; cand--) {\n      var total = cand - i;\n      for (var t2 = i; t2 <= cand; t2++) total += ws[t2].length;\n      if (total <= W) { j = cand; break; }\n    }\n    var width = 0;\n    for (var t3 = i; t3 <= j; t3++) width += ws[t3].length;\n    res.push(assemble(i, j + 1, width, j === n - 1));\n    i = j + 1;\n  }\n  return res;\n}\n",
