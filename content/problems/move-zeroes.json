      "code": "function moveZeroes(nums) {\n  const nonZeros = [];\n  let zeros = 0;\n  for (let i = 0; i < nums.length; i++) {\n    if (nums[i] === 0) {\n      zeros++;\n    } else {\n      nonZeros.push(nums[i]);\n    }\n  }\n  for (let i = 0; i < zeros; i++) {\n    nonZeros.push(0);\n  }\n  return nonZeros;\n}",
