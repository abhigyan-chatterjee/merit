      "title": "Brute Force",
      "complexity": "Time: O(n^2) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums, k) {\n  var n = nums.length;\n  var total = 0;\n  for (var i = 0; i < n; i++) {\n    var counts = new Map();\n    var distinct = 0;\n    for (var j = i; j < n; j++) {\n      var v = nums[j];\n      var c = counts.get(v) || 0;\n      if (c === 0) distinct++;\n      counts.set(v, c + 1);\n      if (distinct === k) total++;\n      else if (distinct > k) break;\n    }\n  }\n  return total;\n}\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums, k) {\n  function atMost(limit) {\n    if (limit <= 0) return 0;\n    var counts = new Map();\n    var distinct = 0;\n    var left = 0;\n    var total = 0;\n    for (var right = 0; right < nums.length; right++) {\n      var v = nums[right];\n      var c = counts.get(v) || 0;\n      if (c === 0) distinct++;\n      counts.set(v, c + 1);\n      while (distinct > limit) {\n        var lv = nums[left];\n        var lc = counts.get(lv) - 1;\n        counts.set(lv, lc);\n        if (lc === 0) distinct--;\n        left++;\n      }\n      total += right - left + 1;\n    }\n    return total;\n  }\n  return atMost(k) - atMost(k - 1);\n}\n",
      "isReference": true
    }
