    {
      "title": "Brute Force",
      "complexity": "Time: O(m*n*(m+n)) | Space: O(m*n)",
      "language": "javascript",
      "code": "function solve(grid) {\n  const rows = grid.length;\n  if (rows === 0) return 0;\n  let colspan = 0;\n  for (const row of grid) if (row.length > colspan) colspan = row.length;\n  const stride = colspan + 1;\n  const label = [];\n  for (let r = 0; r < rows; r++) {\n    const rowlabels = [];\n    for (let c = 0; c < grid[r].length; c++) {\n      rowlabels.push(grid[r][c] === 1 ? r * stride + c : -1);\n    }\n    label.push(rowlabels);\n  }\n  let changed = true;\n  while (changed) {\n    changed = false;\n    for (let r = 0; r < rows; r++) {\n      for (let c = 0; c < label[r].length; c++) {\n        const here = label[r][c];\n        if (here < 0) continue;\n        let best = here;\n        const nr = [r + 1, r - 1, r, r];\n        const nc = [c, c, c + 1, c - 1];\n        for (let k = 0; k < 4; k++) {\n          const rr = nr[k];\n          const cc = nc[k];\n          if (rr >= 0 && rr < rows && cc >= 0 && cc < label[rr].length) {\n            const v = label[rr][cc];\n            if (v >= 0 && v < best) best = v;\n          }\n        }\n        if (best !== here) {\n          label[r][c] = best;\n          changed = true;\n        }\n      }\n    }\n  }\n  const counts = new Map();\n  let bestArea = 0;\n  for (let r = 0; r < rows; r++) {\n    for (let c = 0; c < label[r].length; c++) {\n      const root = label[r][c];\n      if (root >= 0) {\n        const size = (counts.get(root) || 0) + 1;\n        counts.set(root, size);\n        if (size > bestArea) bestArea = size;\n      }\n    }\n  }\n  return bestArea;\n}\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(m*n) | Space: O(m*n)",
      "language": "javascript",
      "code": "function solve(grid) {\n  const rows = grid.length;\n  if (rows === 0) return 0;\n  const seen = grid.map(function (row) { return new Array(row.length).fill(false); });\n  let best = 0;\n  for (let sr = 0; sr < rows; sr++) {\n    for (let sc = 0; sc < grid[sr].length; sc++) {\n      if (grid[sr][sc] !== 1 || seen[sr][sc]) continue;\n      seen[sr][sc] = true;\n      const stack = [[sr, sc]];\n      let area = 0;\n      while (stack.length > 0) {\n        const cell = stack.pop();\n        const r = cell[0];\n        const c = cell[1];\n        area += 1;\n        if (r + 1 < rows && grid[r + 1][c] === 1 && !seen[r + 1][c]) { seen[r + 1][c] = true; stack.push([r + 1, c]); }\n        if (r - 1 >= 0 && grid[r - 1][c] === 1 && !seen[r - 1][c]) { seen[r - 1][c] = true; stack.push([r - 1, c]); }\n        if (c + 1 < grid[r].length && grid[r][c + 1] === 1 && !seen[r][c + 1]) { seen[r][c + 1] = true; stack.push([r, c + 1]); }\n        if (c - 1 >= 0 && grid[r][c - 1] === 1 && !seen[r][c - 1]) { seen[r][c - 1] = true; stack.push([r, c - 1]); }\n      }\n      if (area > best) best = area;\n    }\n  }\n  return best;\n}\n",
      "isReference": true
    }
