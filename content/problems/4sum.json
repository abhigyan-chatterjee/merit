      "title": "Brute Force",
      "complexity": "Time: O(n\u2074 + t log t) | Space: O(t)",
      "language": "javascript",
      "code": "function solve(nums, target) {\n  const n = nums.length;\n  const seen = new Set();\n  const out = [];\n  for (let i = 0; i < n; i++) {\n    for (let j = i + 1; j < n; j++) {\n      for (let k = j + 1; k < n; k++) {\n        for (let l = k + 1; l < n; l++) {\n          if (nums[i] + nums[j] + nums[k] + nums[l] !== target) continue;\n          const q = [nums[i], nums[j], nums[k], nums[l]].sort((x, y) => x - y);\n          const key = q.join(',');\n          if (!seen.has(key)) {\n            seen.add(key);\n            out.push(q);\n          }\n        }\n      }\n    }\n  }\n  out.sort((p, q) => p[0] - q[0] || p[1] - q[1] || p[2] - q[2] || p[3] - q[3]);\n  return out;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n\u00b3) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums, target) {\n  const a = nums.slice().sort((x, y) => x - y);\n  const n = a.length;\n  const out = [];\n  for (let i = 0; i + 3 < n; i++) {\n    if (i > 0 && a[i] === a[i - 1]) continue;\n    for (let j = i + 1; j + 2 < n; j++) {\n      if (j > i + 1 && a[j] === a[j - 1]) continue;\n      let l = j + 1;\n      let r = n - 1;\n      while (l < r) {\n        const s = a[i] + a[j] + a[l] + a[r];\n        if (s === target) {\n          out.push([a[i], a[j], a[l], a[r]]);\n          while (l < r && a[l] === a[l + 1]) l++;\n          while (l < r && a[r] === a[r - 1]) r--;\n          l++;\n          r--;\n        } else if (s < target) {\n          l++;\n        } else {\n          r--;\n        }\n      }\n    }\n  }\n  return out;\n}",
      "isReference": true
    }
