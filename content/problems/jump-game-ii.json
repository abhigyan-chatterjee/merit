  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(n)",
      "language": "javascript",
      "code": "function jump(nums) {\n  const n = nums.length;\n  if (n <= 1) return 0;\n  const dp = new Array(n).fill(Infinity);\n  dp[0] = 0;\n  for (let i = 0; i < n; i++) {\n    if (dp[i] === Infinity) continue;\n    const maxReach = Math.min(n - 1, i + nums[i]);\n    for (let j = i + 1; j <= maxReach; j++) {\n      if (dp[i] + 1 < dp[j]) {\n        dp[j] = dp[i] + 1;\n      }\n    }\n  }\n  return dp[n - 1];\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "javascript",
      "code": "function jump(nums) {\n  const n = nums.length;\n  if (n <= 1) return 0;\n  let jumps = 0, currentEnd = 0, farthest = 0;\n  for (let i = 0; i < n - 1; i++) {\n    if (i + nums[i] > farthest) farthest = i + nums[i];\n    if (i === currentEnd) {\n      jumps++;\n      currentEnd = farthest;\n      if (currentEnd >= n - 1) break;\n    }\n  }\n  return jumps;\n}",
      "isReference": true
    },
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(n)",
      "language": "python",
      "code": "def jump(nums: list[int]) -> int:\n    n = len(nums)\n    if n <= 1:\n        return 0\n    dp = [float(\"inf\")] * n\n    dp[0] = 0\n    for i in range(n):\n        if dp[i] == float(\"inf\"):\n            continue\n        max_reach = min(n - 1, i + nums[i])\n        for j in range(i + 1, max_reach + 1):\n            if dp[i] + 1 < dp[j]:\n                dp[j] = dp[i] + 1\n    return int(dp[-1])\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "python",
      "code": "def jump(nums: list[int]) -> int:\n    n = len(nums)\n    if n <= 1:\n        return 0\n    jumps = 0\n    current_end = 0\n    farthest = 0\n    for i in range(n - 1):\n        farthest = max(farthest, i + nums[i])\n        if i == current_end:\n            jumps += 1\n            current_end = farthest\n            if current_end >= n - 1:\n                break\n    return jumps\n",
