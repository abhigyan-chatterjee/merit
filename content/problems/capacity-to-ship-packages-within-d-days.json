  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(sum(weights) * weights.length) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(weights, days) {\n  let lo = 0, hi = 0;\n  for (const w of weights) { if (w > lo) lo = w; hi += w; }\n  for (let capacity = lo; capacity <= hi; capacity++) {\n    let used = 1, load = 0;\n    for (const w of weights) {\n      if (load + w <= capacity) load += w;\n      else { used++; load = w; }\n    }\n    if (used <= days) return capacity;\n  }\n  return hi;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(weights.length * log(sum(weights))) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(weights, days) {\n  let lo = 0, hi = 0;\n  for (const w of weights) { if (w > lo) lo = w; hi += w; }\n  while (lo < hi) {\n    const mid = lo + Math.floor((hi - lo) / 2);\n    let used = 1, load = 0;\n    for (const w of weights) {\n      if (load + w <= mid) load += w;\n      else { used++; load = w; }\n    }\n    if (used <= days) hi = mid; else lo = mid + 1;\n  }\n  return lo;\n}",
      "isReference": true
    }
  ],
