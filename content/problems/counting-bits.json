      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "javascript",
      "code": "function countBits(n) {\n  const res = new Array(n + 1).fill(0);\n  for (let i = 1; i <= n; i++) {\n    res[i] = res[i >> 1] + (i & 1);\n  }\n  return res;\n}",
