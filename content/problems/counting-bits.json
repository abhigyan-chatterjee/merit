      "language": "javascript",
      "code": "function countBits(n) {\n  const res = new Array(n + 1);\n  for (let i = 0; i <= n; i++) {\n    let count = 0;\n    let x = i;\n    while (x > 0) {\n      count += (x & 1);\n      x >>>= 1;\n    }\n    res[i] = count;\n  }\n  return res;\n}",
