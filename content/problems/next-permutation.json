      "complexity": "Time: O(n^3 log n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums) {\n  const n = nums.length;\n  const isGreater = (a, b) => {\n    for (let t = 0; t < n; t++) {\n      if (a[t] !== b[t]) return a[t] > b[t];\n    }\n    return false;\n  };\n  const isSmaller = (a, b) => {\n    for (let t = 0; t < n; t++) {\n      if (a[t] !== b[t]) return a[t] < b[t];\n    }\n    return false;\n  };\n  let best = null;\n  for (let i = 0; i < n; i++) {\n    for (let j = i + 1; j < n; j++) {\n      const cand = nums.slice();\n      const tmp = cand[i];\n      cand[i] = cand[j];\n      cand[j] = tmp;\n      const suffix = cand.slice(i + 1).sort((x, y) => x - y);\n      for (let t = 0; t < suffix.length; t++) cand[i + 1 + t] = suffix[t];\n      if (!isGreater(cand, nums)) continue;\n      if (best === null || isSmaller(cand, best)) best = cand;\n    }\n  }\n  if (best === null) {\n    const sorted = nums.slice();\n    sorted.sort((x, y) => x - y);\n    return sorted;\n  }\n  return best;\n}",
