  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(prices) {\n  const n = prices.length;\n  const dp = new Array(n + 1).fill(0);\n  for (let t = 1; t <= n; t++) {\n    let best = dp[t - 1];\n    for (let j = 0; j + 1 < t; j++) {\n      const cand = dp[j + 1] + prices[t - 1] - prices[j];\n      if (cand > best) best = cand;\n    }\n    dp[t] = best;\n  }\n  return dp[n];\n}\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(prices) {\n  let profit = 0;\n  for (let i = 1; i < prices.length; i++) {\n    if (prices[i] > prices[i - 1]) profit += prices[i] - prices[i - 1];\n  }\n  return profit;\n}\n",
      "isReference": true
    }
  ],
