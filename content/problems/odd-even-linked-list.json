  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function oddEvenList(nums) {\n  if (nums.length <= 2) return nums.slice();\n  const odds = [];\n  const evens = [];\n  for (let i = 0; i < nums.length; i++) {\n    if ((i + 1) % 2 === 1) {\n      odds.push(nums[i]);\n    } else {\n      evens.push(nums[i]);\n    }\n  }\n  const result = [];\n  for (let i = 0; i < odds.length; i++) result.push(odds[i]);\n  for (let i = 0; i < evens.length; i++) result.push(evens[i]);\n  return result;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
