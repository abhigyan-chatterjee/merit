      "language": "javascript",
      "code": "function nextGreaterElement(nums1, nums2) {\n  const answers = [];\n  for (let i = 0; i < nums1.length; i++) {\n    let found = -1;\n    for (let j = 0; j < nums2.length; j++) {\n      if (nums2[j] === nums1[i]) {\n        for (let k = j + 1; k < nums2.length; k++) {\n          if (nums2[k] > nums2[j]) {\n            found = nums2[k];\n            break;\n          }\n        }\n        break;\n      }\n    }\n    answers.push(found);\n  }\n  return answers;\n}",
