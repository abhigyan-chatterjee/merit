      "code": "def nextGreaterElement(nums1: list[int], nums2: list[int]) -> list[int]:\n    answers = []\n    for i in range(len(nums1)):\n        found = -1\n        for j in range(len(nums2)):\n            if nums2[j] == nums1[i]:\n                for k in range(j + 1, len(nums2)):\n                    if nums2[k] > nums2[j]:\n                        found = nums2[k]\n                        break\n                break\n        answers.append(found)\n    return answers\n",
