  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n^2) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(salaries) {\n  const arr = salaries.slice();\n  for (let i = 0; i < arr.length; i++) {\n    for (let j = 0; j < arr.length - 1 - i; j++) {\n      if (arr[j] < arr[j + 1]) {\n        const t = arr[j];\n        arr[j] = arr[j + 1];\n        arr[j + 1] = t;\n      }\n    }\n  }\n  for (let i = 1; i < arr.length; i++) {\n    if (arr[i] !== arr[0]) return arr[i];\n  }\n  return -1;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(salaries) {\n  let best = -Infinity;\n  let second = -Infinity;\n  for (const s of salaries) {\n    if (s > best) {\n      second = best;\n      best = s;\n    } else if (s < best && s > second) {\n      second = s;\n    }\n  }\n  return second === -Infinity ? -1 : second;\n}",
      "isReference": true
    }
  ],
