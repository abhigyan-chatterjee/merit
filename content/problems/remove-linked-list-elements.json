  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function removeElements(nums, val) {\n  const result = [];\n  for (let i = 0; i < nums.length; i++) {\n    if (nums[i] !== val) {\n      result.push(nums[i]);\n    }\n  }\n  return result;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function removeElements(nums, val) {\n  return nums.filter(x => x !== val);\n}",
      "isReference": true
    },
    {
      "title": "Brute Force",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "python",
      "code": "def removeElements(nums: list[int], val: int) -> list[int]:\n    res = []\n    for x in nums:\n        if x != val:\n            res.append(x)\n    return res\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "python",
      "code": "def removeElements(nums: list[int], val: int) -> list[int]:\n    return [x for x in nums if x != val]\n",
