    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(nums) {\n  const n = nums.length;\n  let total = 0;\n  for (let i = 0; i < n; i++) {\n    let m = nums[i];\n    for (let j = i; j < n; j++) {\n      if (nums[j] < m) m = nums[j];\n      total += m;\n    }\n  }\n  return total;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums) {\n  const n = nums.length;\n  const dp = new Array(n).fill(0);\n  const stack = [];\n  let total = 0;\n  for (let i = 0; i < n; i++) {\n    while (stack.length > 0 && nums[stack[stack.length - 1]] >= nums[i]) {\n      stack.pop();\n    }\n    if (stack.length > 0) {\n      const j = stack[stack.length - 1];\n      dp[i] = dp[j] + nums[i] * (i - j);\n    } else {\n      dp[i] = nums[i] * (i + 1);\n    }\n    total += dp[i];\n    stack.push(i);\n  }\n  return total;\n}",
      "isReference": true
    }
