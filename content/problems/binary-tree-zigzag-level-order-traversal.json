      "language": "javascript",
      "code": "function solve(tree) {\n  const n = tree.length;\n  if (n === 0) return [];\n  const res = [];\n  let frontier = [0];\n  let level = 0;\n  while (frontier.length > 0) {\n    const vals = frontier.map(i => tree[i]);\n    if (level % 2 === 1) vals.reverse();\n    res.push(vals);\n    const nxt = [];\n    for (const u of frontier) {\n      for (let j = 1; j < n; j++) {\n        if (Math.floor((j - 1) / 2) === u) nxt.push(j);\n      }\n    }\n    frontier = nxt;\n    level += 1;\n  }\n  return res;\n}\n",
