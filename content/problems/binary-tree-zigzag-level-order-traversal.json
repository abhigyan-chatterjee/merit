      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(tree) {\n  const n = tree.length;\n  if (n === 0) return [];\n  const res = [];\n  let frontier = [0];\n  let level = 0;\n  while (frontier.length > 0) {\n    const vals = frontier.map(i => tree[i]);\n    if (level % 2 === 1) vals.reverse();\n    res.push(vals);\n    const nxt = [];\n    for (const i of frontier) {\n      if (2 * i + 1 < n) nxt.push(2 * i + 1);\n      if (2 * i + 2 < n) nxt.push(2 * i + 2);\n    }\n    frontier = nxt;\n    level += 1;\n  }\n  return res;\n}\n",
