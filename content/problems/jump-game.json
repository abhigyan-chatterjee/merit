  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(n)",
      "language": "javascript",
      "code": "function canJump(nums) {\n  const n = nums.length;\n  const dp = new Array(n).fill(false);\n  dp[n - 1] = true;\n  for (let i = n - 2; i >= 0; i--) {\n    const furthest = Math.min(i + nums[i], n - 1);\n    for (let j = i + 1; j <= furthest; j++) {\n      if (dp[j]) {\n        dp[i] = true;\n        break;\n      }\n    }\n  }\n  return dp[0];\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "javascript",
      "code": "function canJump(nums) {\n  let maxReach = 0;\n  for (let i = 0; i < nums.length; i++) {\n    if (i > maxReach) return false;\n    if (i + nums[i] > maxReach) {\n      maxReach = i + nums[i];\n    }\n    if (maxReach >= nums.length - 1) return true;\n  }\n  return true;\n}",
      "isReference": true
    },
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(n)",
      "language": "python",
      "code": "def canJump(nums: list[int]) -> bool:\n    n = len(nums)\n    dp = [False] * n\n    dp[-1] = True\n    for i in range(n - 2, -1, -1):\n        furthest = min(i + nums[i], n - 1)\n        for j in range(i + 1, furthest + 1):\n            if dp[j]:\n                dp[i] = True\n                break\n    return dp[0]\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "python",
      "code": "def canJump(nums: list[int]) -> bool:\n    max_reach = 0\n    for i, jump in enumerate(nums):\n        if i > max_reach:\n            return False\n        if i + jump > max_reach:\n            max_reach = i + jump\n        if max_reach >= len(nums) - 1:\n            return True\n    return True\n",
      "isReference": true
    }
