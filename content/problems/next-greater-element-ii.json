    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(nums) {\n  var n = nums.length;\n  var res = [];\n  for (var i = 0; i < n; i++) {\n    var found = -1;\n    for (var k = 1; k < n; k++) {\n      var candidate = nums[(i + k) % n];\n      if (candidate > nums[i]) {\n        found = candidate;\n        break;\n      }\n    }\n    res.push(found);\n  }\n  return res;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums) {\n  var n = nums.length;\n  var res = new Array(n);\n  var stack = [];\n  for (var q = 0; q < n; q++) res[q] = -1;\n  for (var i = 0; i < 2 * n; i++) {\n    var idx = i % n;\n    while (stack.length > 0 && nums[stack[stack.length - 1]] < nums[idx]) {\n      res[stack.pop()] = nums[idx];\n    }\n    if (i < n) stack.push(idx);\n  }\n  return res;\n}",
      "isReference": true
    }
  ],
