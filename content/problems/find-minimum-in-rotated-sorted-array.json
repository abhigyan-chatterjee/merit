  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "javascript",
      "code": "function findMin(nums) {\n  let minVal = nums[0];\n  for (let i = 1; i < nums.length; i++) {\n    if (nums[i] < minVal) minVal = nums[i];\n  }\n  return minVal;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(log n) | Space: O(1)",
      "language": "javascript",
      "code": "function findMin(nums) {\n  let low = 0;\n  let high = nums.length - 1;\n  while (low < high) {\n    const mid = Math.floor((low + high) / 2);\n    if (nums[mid] > nums[high]) {\n      low = mid + 1;\n    } else {\n      high = mid;\n    }\n  }\n  return nums[low];\n}",
      "isReference": true
    },
    {
      "title": "Brute Force",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "python",
      "code": "def findMin(nums: list[int]) -> int:\n    min_val = nums[0]\n    for x in nums:\n        if x < min_val:\n            min_val = x\n    return min_val\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(log n) | Space: O(1)",
      "language": "python",
      "code": "def findMin(nums: list[int]) -> int:\n    low, high = 0, len(nums) - 1\n    while low < high:\n        mid = (low + high) // 2\n        if nums[mid] > nums[high]:\n            low = mid + 1\n        else:\n            high = mid\n    return nums[low]\n",
      "isReference": true
    }
