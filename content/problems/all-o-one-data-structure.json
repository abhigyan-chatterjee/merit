      "title": "Brute Force",
      "complexity": "Time: O(u + q * n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(ops, keys) {\n  const counts = new Map();\n  const res = [];\n  const n = Math.min(ops.length, keys.length);\n  for (let i = 0; i < n; i++) {\n    const op = ops[i];\n    const key = keys[i];\n    if (op === 1) {\n      counts.set(key, (counts.get(key) || 0) + 1);\n    } else if (op === 2) {\n      const c = counts.get(key);\n      if (c === undefined) continue;\n      if (c <= 1) counts.delete(key);\n      else counts.set(key, c - 1);\n    } else if (op === 3 || op === 4) {\n      let best = -1;\n      let bestCount = 0;\n      let found = false;\n      for (const entry of counts) {\n        const k = entry[0];\n        const c = entry[1];\n        if (!found) {\n          best = k;\n          bestCount = c;\n          found = true;\n          continue;\n        }\n        const better = op === 3 ? c > bestCount : c < bestCount;\n        if (better || (c === bestCount && k < best)) {\n          best = k;\n          bestCount = c;\n        }\n      }\n      res.push(found ? best : -1);\n    }\n  }\n  return res;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(u + q * k) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(ops, keys) {\n  const where = new Map();\n  let head = null;\n  let tail = null;\n  const res = [];\n\n  const insertBefore = (b, count) => {\n    const nb = { count: count, keys: new Set(), prev: b.prev, next: b };\n    if (b.prev) b.prev.next = nb;\n    else head = nb;\n    b.prev = nb;\n    return nb;\n  };\n  const insertAtHead = (count) => {\n    const nb = { count: count, keys: new Set(), prev: null, next: head };\n    if (head) head.prev = nb;\n    else tail = nb;\n    head = nb;\n    return nb;\n  };\n  const insertAfter = (b, count) => {\n    const nb = { count: count, keys: new Set(), prev: b, next: b.next };\n    if (b.next) b.next.prev = nb;\n    else tail = nb;\n    b.next = nb;\n    return nb;\n  };\n  const detach = (b) => {\n    if (b.prev) b.prev.next = b.next;\n    else head = b.next;\n    if (b.next) b.next.prev = b.prev;\n    else tail = b.prev;\n  };\n  const drop = (key, b) => {\n    b.keys.delete(key);\n    if (b.keys.size === 0) detach(b);\n  };\n  const smallest = (b) => {\n    let best = null;\n    for (const k of b.keys) {\n      if (best === null || k < best) best = k;\n    }\n    return best;\n  };\n\n  const n = Math.min(ops.length, keys.length);\n  for (let i = 0; i < n; i++) {\n    const op = ops[i];\n    const key = keys[i];\n    if (op === 1) {\n      const b = where.get(key);\n      if (b === undefined) {\n        let target = head;\n        if (!target || target.count !== 1) target = insertAtHead(1);\n        target.keys.add(key);\n        where.set(key, target);\n      } else {\n        const next = b.count + 1;\n        let target = b.next;\n        if (!target || target.count !== next) target = insertAfter(b, next);\n        drop(key, b);\n        target.keys.add(key);\n        where.set(key, target);\n      }\n    } else if (op === 2) {\n      const b = where.get(key);\n      if (b === undefined) continue;\n      if (b.count === 1) {\n        drop(key, b);\n        where.delete(key);\n      } else {\n        const prev = b.count - 1;\n        let target = b.prev;\n        if (!target || target.count !== prev) target = insertBefore(b, prev);\n        drop(key, b);\n        target.keys.add(key);\n        where.set(key, target);\n      }\n    } else if (op === 3) {\n      res.push(tail ? smallest(tail) : -1);\n    } else if (op === 4) {\n      res.push(head ? smallest(head) : -1);\n    }\n  }\n  return res;\n}",
