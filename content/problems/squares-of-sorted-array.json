      "code": "function sortedSquares(nums) {\n  const sorted = [...nums].sort((a, b) => a - b);\n  const squared = [];\n  for (let i = 0; i < sorted.length; i++) {\n    squared.push(sorted[i] * sorted[i]);\n  }\n  squared.sort((a, b) => a - b);\n  return squared;\n}",
