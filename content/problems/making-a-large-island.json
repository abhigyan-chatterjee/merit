    {
      "title": "Brute Force",
      "complexity": "Time: O((m * n)^2) | Space: O(m * n)",
      "language": "javascript",
      "code": "function solve(grid) {\n  const m = grid.length;\n  const n = grid[0].length;\n  const dirs = [[1, 0], [-1, 0], [0, 1], [0, -1]];\n  const largest = () => {\n    const seen = [];\n    for (let i = 0; i < m; i++) seen.push(new Array(n).fill(false));\n    let best = 0;\n    for (let i = 0; i < m; i++) {\n      for (let j = 0; j < n; j++) {\n        if (grid[i][j] !== 1 || seen[i][j]) continue;\n        let size = 0;\n        const stack = [[i, j]];\n        seen[i][j] = true;\n        while (stack.length > 0) {\n          const cell = stack.pop();\n          size++;\n          for (const d of dirs) {\n            const ni = cell[0] + d[0];\n            const nj = cell[1] + d[1];\n            if (ni >= 0 && ni < m && nj >= 0 && nj < n && grid[ni][nj] === 1 && !seen[ni][nj]) {\n              seen[ni][nj] = true;\n              stack.push([ni, nj]);\n            }\n          }\n        }\n        if (size > best) best = size;\n      }\n    }\n    return best;\n  };\n  let best = largest();\n  for (let i = 0; i < m; i++) {\n    for (let j = 0; j < n; j++) {\n      if (grid[i][j] !== 0) continue;\n      grid[i][j] = 1;\n      const candidate = largest();\n      if (candidate > best) best = candidate;\n      grid[i][j] = 0;\n    }\n  }\n  return best;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(m * n) | Space: O(m * n)",
      "language": "javascript",
      "code": "function solve(grid) {\n  const m = grid.length;\n  const n = grid[0].length;\n  const dirs = [[1, 0], [-1, 0], [0, 1], [0, -1]];\n  const comp = [];\n  for (let i = 0; i < m; i++) comp.push(new Array(n).fill(0));\n  const sizes = [0];\n  let best = 0;\n  for (let i = 0; i < m; i++) {\n    for (let j = 0; j < n; j++) {\n      if (grid[i][j] !== 1 || comp[i][j] !== 0) continue;\n      const id = sizes.length;\n      let size = 0;\n      const stack = [[i, j]];\n      comp[i][j] = id;\n      while (stack.length > 0) {\n        const cell = stack.pop();\n        size++;\n        for (const d of dirs) {\n          const ni = cell[0] + d[0];\n          const nj = cell[1] + d[1];\n          if (ni >= 0 && ni < m && nj >= 0 && nj < n && grid[ni][nj] === 1 && comp[ni][nj] === 0) {\n            comp[ni][nj] = id;\n            stack.push([ni, nj]);\n          }\n        }\n      }\n      sizes.push(size);\n      if (size > best) best = size;\n    }\n  }\n  for (let i = 0; i < m; i++) {\n    for (let j = 0; j < n; j++) {\n      if (grid[i][j] !== 0) continue;\n      const used = new Set();\n      let candidate = 1;\n      for (const d of dirs) {\n        const ni = i + d[0];\n        const nj = j + d[1];\n        if (ni >= 0 && ni < m && nj >= 0 && nj < n && comp[ni][nj] > 0 && !used.has(comp[ni][nj])) {\n          used.add(comp[ni][nj]);\n          candidate += sizes[comp[ni][nj]];\n        }\n      }\n      if (candidate > best) best = candidate;\n    }\n  }\n  return best;\n}",
