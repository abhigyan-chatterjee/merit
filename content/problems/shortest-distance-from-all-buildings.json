    {
      "title": "Brute Force",
      "complexity": "Time: O((m*n)^2) | Space: O(m*n)",
      "language": "javascript",
      "code": "function solve(grid) {\n  const m = grid.length;\n  if (m === 0) return -1;\n  const n = grid[0].length;\n  const buildings = [];\n  for (let i = 0; i < m; i++) {\n    for (let j = 0; j < n; j++) {\n      if (grid[i][j] === 1) buildings.push([i, j]);\n    }\n  }\n  if (buildings.length === 0) return -1;\n  const dirs = [[1, 0], [-1, 0], [0, 1], [0, -1]];\n  let best = -1;\n  for (let si = 0; si < m; si++) {\n    for (let sj = 0; sj < n; sj++) {\n      if (grid[si][sj] !== 0) continue;\n      const dist = [];\n      for (let i = 0; i < m; i++) dist.push(new Array(n).fill(-1));\n      dist[si][sj] = 0;\n      const queue = [[si, sj]];\n      for (let head = 0; head < queue.length; head++) {\n        const x = queue[head][0];\n        const y = queue[head][1];\n        for (let d = 0; d < 4; d++) {\n          const nx = x + dirs[d][0];\n          const ny = y + dirs[d][1];\n          if (nx < 0 || ny < 0 || nx >= m || ny >= n) continue;\n          if (grid[nx][ny] === 2) continue;\n          if (dist[nx][ny] !== -1) continue;\n          dist[nx][ny] = dist[x][y] + 1;\n          queue.push([nx, ny]);\n        }\n      }\n      let total = 0;\n      let ok = true;\n      for (let b = 0; b < buildings.length; b++) {\n        const d = dist[buildings[b][0]][buildings[b][1]];\n        if (d === -1) { ok = false; break; }\n        total += d;\n      }\n      if (ok && (best === -1 || total < best)) best = total;\n    }\n  }\n  return best;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(m*n*B) | Space: O(m*n)",
      "language": "javascript",
      "code": "function solve(grid) {\n  const m = grid.length;\n  if (m === 0) return -1;\n  const n = grid[0].length;\n  const total = [];\n  const reached = [];\n  for (let i = 0; i < m; i++) {\n    total.push(new Array(n).fill(0));\n    reached.push(new Array(n).fill(0));\n  }\n  const dirs = [[1, 0], [-1, 0], [0, 1], [0, -1]];\n  let buildings = 0;\n  for (let si = 0; si < m; si++) {\n    for (let sj = 0; sj < n; sj++) {\n      if (grid[si][sj] !== 1) continue;\n      buildings++;\n      const dist = [];\n      for (let i = 0; i < m; i++) dist.push(new Array(n).fill(-1));\n      dist[si][sj] = 0;\n      const queue = [[si, sj]];\n      for (let head = 0; head < queue.length; head++) {\n        const x = queue[head][0];\n        const y = queue[head][1];\n        if (grid[x][y] === 0) {\n          total[x][y] += dist[x][y];\n          reached[x][y]++;\n        }\n        for (let d = 0; d < 4; d++) {\n          const nx = x + dirs[d][0];\n          const ny = y + dirs[d][1];\n          if (nx < 0 || ny < 0 || nx >= m || ny >= n) continue;\n          if (grid[nx][ny] === 2) continue;\n          if (dist[nx][ny] !== -1) continue;\n          dist[nx][ny] = dist[x][y] + 1;\n          queue.push([nx, ny]);\n        }\n      }\n    }\n  }\n  if (buildings === 0) return -1;\n  let best = -1;\n  for (let i = 0; i < m; i++) {\n    for (let j = 0; j < n; j++) {\n      if (grid[i][j] !== 0) continue;\n      if (reached[i][j] !== buildings) continue;\n      if (best === -1 || total[i][j] < best) best = total[i][j];\n    }\n  }\n  return best;\n}",
      "isReference": true
