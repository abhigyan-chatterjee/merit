  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n^2) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums) {\n  const counts = new Map();\n  for (const v of nums) counts.set(v, (counts.get(v) || 0) + 1);\n  const vals = Array.from(counts.keys()).sort((a, b) => a - b);\n  const k = vals.length;\n  const dp = new Array(k).fill(0);\n  for (let i = 0; i < k; i++) {\n    const earn = vals[i] * counts.get(vals[i]);\n    let best = earn;\n    for (let j = 0; j < i; j++) {\n      if (vals[i] - vals[j] >= 2) best = Math.max(best, dp[j] + earn);\n    }\n    if (i > 0) best = Math.max(best, dp[i - 1]);\n    dp[i] = best;\n  }\n  return dp[k - 1];\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n + max(nums)) | Space: O(max(nums))",
      "language": "javascript",
      "code": "function solve(nums) {\n  let maxV = 0;\n  for (const v of nums) if (v > maxV) maxV = v;\n  const counts = new Array(maxV + 1).fill(0);\n  for (const v of nums) counts[v]++;\n  let twoBack = 0;\n  let oneBack = 0;\n  for (let v = 1; v <= maxV; v++) {\n    const take = twoBack + v * counts[v];\n    const best = take > oneBack ? take : oneBack;\n    twoBack = oneBack;\n    oneBack = best;\n  }\n  return oneBack;\n}",
      "isReference": true
    }
