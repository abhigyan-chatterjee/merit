      "title": "Brute Force",
      "complexity": "Time: O(n*m) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(balance, ops) {\n  const n = balance.length;\n  const result = balance.slice();\n  const flags = [];\n  const groups = Math.floor(ops.length / 4);\n  for (let k = 0; k < groups; k++) {\n    const accounts = new Map();\n    for (let i = 0; i < n; i++) accounts.set(i + 1, result[i]);\n    const base = 4 * k;\n    const type = ops[base];\n    const a = ops[base + 1];\n    const b = ops[base + 2];\n    const amount = ops[base + 3];\n    let valid = false;\n    if (type === 0) {\n      if (accounts.has(a)) valid = true;\n    } else if (type === 1) {\n      if (accounts.has(a) && accounts.get(a) >= amount) valid = true;\n    } else if (type === 2) {\n      if (accounts.has(a) && accounts.has(b) && accounts.get(a) >= amount) valid = true;\n    }\n    if (valid) {\n      if (type === 0) {\n        accounts.set(a, accounts.get(a) + amount);\n      } else if (type === 1) {\n        accounts.set(a, accounts.get(a) - amount);\n      } else {\n        accounts.set(a, accounts.get(a) - amount);\n        accounts.set(b, accounts.get(b) + amount);\n      }\n      for (let i = 0; i < n; i++) result[i] = accounts.get(i + 1);\n    }\n    flags.push(valid ? 1 : 0);\n  }\n  return [result, flags];\n}",
