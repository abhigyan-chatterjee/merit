      "language": "javascript",
      "code": "function solve(balance, ops) {\n  const n = balance.length;\n  const result = balance.slice();\n  const flags = [];\n  const groups = Math.floor(ops.length / 4);\n  for (let k = 0; k < groups; k++) {\n    const base = 4 * k;\n    const type = ops[base];\n    const a = ops[base + 1];\n    const b = ops[base + 2];\n    const amount = ops[base + 3];\n    let valid = false;\n    if (type === 0) {\n      if (a >= 1 && a <= n) valid = true;\n    } else if (type === 1) {\n      if (a >= 1 && a <= n && result[a - 1] >= amount) valid = true;\n    } else if (type === 2) {\n      if (a >= 1 && a <= n && b >= 1 && b <= n && result[a - 1] >= amount) valid = true;\n    }\n    if (valid) {\n      if (type === 0) {\n        result[a - 1] += amount;\n      } else if (type === 1) {\n        result[a - 1] -= amount;\n      } else {\n        result[a - 1] -= amount;\n        result[b - 1] += amount;\n      }\n    }\n    flags.push(valid ? 1 : 0);\n  }\n  return [result, flags];\n}",
