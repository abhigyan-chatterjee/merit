    {
      "title": "Brute Force",
      "complexity": "Time: O(m*n^2) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums, m) {\n  var n = nums.length;\n  var prefix = new Array(n + 1);\n  prefix[0] = 0;\n  for (var i = 0; i < n; i++) prefix[i + 1] = prefix[i] + nums[i];\n  var prev = new Array(n + 1);\n  for (var t = 0; t <= n; t++) prev[t] = Infinity;\n  prev[0] = 0;\n  for (var g = 1; g <= m; g++) {\n    var cur = new Array(n + 1);\n    for (var t2 = 0; t2 <= n; t2++) cur[t2] = Infinity;\n    for (var i2 = g; i2 <= n; i2++) {\n      for (var j = g - 1; j < i2; j++) {\n        if (prev[j] === Infinity) continue;\n        var seg = prefix[i2] - prefix[j];\n        var cand = prev[j] > seg ? prev[j] : seg;\n        if (cand < cur[i2]) cur[i2] = cand;\n      }\n    }\n    prev = cur;\n  }\n  return prev[n];\n}\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n log S) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(nums, m) {\n  var n = nums.length;\n  var lo = 0;\n  var hi = 0;\n  for (var i = 0; i < n; i++) {\n    hi += nums[i];\n    if (nums[i] > lo) lo = nums[i];\n  }\n  function feasible(limit) {\n    var groups = 1;\n    var sum = 0;\n    for (var t = 0; t < n; t++) {\n      if (sum + nums[t] <= limit) {\n        sum += nums[t];\n      } else {\n        groups++;\n        sum = nums[t];\n        if (groups > m) return false;\n      }\n    }\n    return groups <= m;\n  }\n  while (lo < hi) {\n    var mid = Math.floor((lo + hi) / 2);\n    if (feasible(mid)) hi = mid; else lo = mid + 1;\n  }\n  return lo;\n}\n",
      "isReference": true
    }
