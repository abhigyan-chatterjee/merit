    {
      "title": "Brute Force",
      "complexity": "Time: O(R\u00b2 C\u00b2) | Space: O(R C)",
      "language": "javascript",
      "code": "function solve(grid) {\n  const rows = grid.length;\n  if (rows === 0 || grid[0].length === 0) return 0;\n  const cols = grid[0].length;\n  const pre = [];\n  for (let r = 0; r <= rows; r++) pre.push(new Array(cols + 1).fill(0));\n  for (let r = 1; r <= rows; r++) {\n    for (let c = 1; c <= cols; c++) {\n      const one = grid[r - 1][c - 1] === 1 ? 1 : 0;\n      pre[r][c] = pre[r - 1][c] + pre[r][c - 1] - pre[r - 1][c - 1] + one;\n    }\n  }\n  let best = 0;\n  for (let r1 = 0; r1 < rows; r1++) {\n    for (let r2 = r1; r2 < rows; r2++) {\n      for (let c1 = 0; c1 < cols; c1++) {\n        for (let c2 = c1; c2 < cols; c2++) {\n          const ones = pre[r2 + 1][c2 + 1] - pre[r1][c2 + 1] - pre[r2 + 1][c1] + pre[r1][c1];\n          const area = (r2 - r1 + 1) * (c2 - c1 + 1);\n          if (ones === area && area > best) best = area;\n        }\n      }\n    }\n  }\n  return best;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(R C) | Space: O(C)",
      "language": "javascript",
      "code": "function solve(grid) {\n  const rows = grid.length;\n  if (rows === 0 || grid[0].length === 0) return 0;\n  const cols = grid[0].length;\n  const heights = new Array(cols).fill(0);\n  let best = 0;\n  for (let r = 0; r < rows; r++) {\n    for (let c = 0; c < cols; c++) {\n      heights[c] = grid[r][c] === 1 ? heights[c] + 1 : 0;\n    }\n    const stack = [];\n    for (let c = 0; c <= cols; c++) {\n      const cur = c < cols ? heights[c] : 0;\n      while (stack.length > 0 && heights[stack[stack.length - 1]] >= cur) {\n        const h = heights[stack.pop()];\n        const left = stack.length > 0 ? stack[stack.length - 1] : -1;\n        const area = h * (c - left - 1);\n        if (area > best) best = area;\n      }\n      if (c < cols) stack.push(c);\n    }\n  }\n  return best;\n}",
      "isReference": true
    }
