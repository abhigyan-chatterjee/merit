  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function singleNumber(nums) {\n  const counts = {};\n  for (let i = 0; i < nums.length; i++) {\n    counts[nums[i]] = (counts[nums[i]] || 0) + 1;\n  }\n  for (const k in counts) {\n    if (counts[k] === 1) return Number(k);\n  }\n  return nums[0];\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "javascript",
      "code": "function singleNumber(nums) {\n  let res = 0;\n  for (let i = 0; i < nums.length; i++) {\n    res ^= nums[i];\n  }\n  return res;\n}",
      "isReference": true
    },
    {
      "title": "Brute Force",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "python",
      "code": "def singleNumber(nums: list[int]) -> int:\n    from collections import Counter\n    counts = Counter(nums)\n    for num, count in counts.items():\n        if count == 1:\n            return num\n    return nums[0]\n",
      "isReference": false
    },
