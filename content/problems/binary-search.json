    {
      "title": "Brute Force",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "javascript",
      "code": "function binarySearch(nums, target) {\n  for (let i = 0; i < nums.length; i++) {\n    if (nums[i] === target) return i;\n  }\n  return -1;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(log n) | Space: O(1)",
      "language": "javascript",
      "code": "function binarySearch(nums, target) {\n  let left = 0;\n  let right = nums.length - 1;\n  while (left <= right) {\n    const mid = Math.floor((left + right) / 2);\n    if (nums[mid] === target) {\n      return mid;\n    } else if (nums[mid] < target) {\n      left = mid + 1;\n    } else {\n      right = mid - 1;\n    }\n  }\n  return -1;\n}",
      "isReference": true
    },
    {
      "title": "Brute Force",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "python",
      "code": "def binarySearch(nums: list[int], target: int) -> int:\n    for i, num in enumerate(nums):\n        if num == target:\n            return i\n    return -1\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(log n) | Space: O(1)",
      "language": "python",
      "code": "def binarySearch(nums: list[int], target: int) -> int:\n    left, right = 0, len(nums) - 1\n    while left <= right:\n        mid = (left + right) // 2\n        if nums[mid] == target:\n            return mid\n        elif nums[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return -1\n",
      "isReference": true
