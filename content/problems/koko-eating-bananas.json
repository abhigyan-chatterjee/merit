  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(m \u00b7 n) | Space: O(1)",
      "language": "javascript",
      "code": "function minEatingSpeed(piles, h) {\n  let maxPile = 0;\n  for (let i = 0; i < piles.length; i++) {\n    if (piles[i] > maxPile) maxPile = piles[i];\n  }\n  for (let k = 1; k <= maxPile; k++) {\n    let hours = 0;\n    for (let i = 0; i < piles.length; i++) {\n      hours += Math.ceil(piles[i] / k);\n    }\n    if (hours <= h) return k;\n  }\n  return maxPile;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n log m) | Space: O(1)",
      "language": "javascript",
      "code": "function minEatingSpeed(piles, h) {\n  let low = 1;\n  let high = 0;\n  for (let i = 0; i < piles.length; i++) {\n    if (piles[i] > high) high = piles[i];\n  }\n  let ans = high;\n  while (low <= high) {\n    const mid = Math.floor((low + high) / 2);\n    let hours = 0;\n    for (let i = 0; i < piles.length; i++) {\n      hours += Math.ceil(piles[i] / mid);\n    }\n    if (hours <= h) {\n      ans = mid;\n      high = mid - 1;\n    } else {\n      low = mid + 1;\n    }\n  }\n  return ans;\n}",
      "isReference": true
    },
    {
      "title": "Brute Force",
      "complexity": "Time: O(m \u00b7 n) | Space: O(1)",
      "language": "python",
      "code": "def minEatingSpeed(piles: list[int], h: int) -> int:\n    import math\n    max_pile = max(piles)\n    for k in range(1, max_pile + 1):\n        hours = sum(math.ceil(p / k) for p in piles)\n        if hours <= h:\n            return k\n    return max_pile\n",
      "isReference": false
