      "code": "function solve(ops, vals) {\n  var n = Math.min(ops.length, vals.length);\n  var stack = [];\n  var mins = [];\n  var out = [];\n  for (var i = 0; i < n; i++) {\n    var c = ops[i];\n    if (c === 'p') {\n      var v = vals[i];\n      stack.push(v);\n      mins.push(mins.length > 0 ? Math.min(mins[mins.length - 1], v) : v);\n    } else if (c === 'o') {\n      if (stack.length > 0) {\n        stack.pop();\n        mins.pop();\n      }\n    } else if (c === 't') {\n      out.push(stack.length > 0 ? stack[stack.length - 1] : -1);\n    } else {\n      out.push(mins.length > 0 ? mins[mins.length - 1] : -1);\n    }\n  }\n  return out;\n}",
