      "language": "javascript",
      "code": "function solve(ops, vals) {\n  var n = Math.min(ops.length, vals.length);\n  var stack = [];\n  var out = [];\n  for (var i = 0; i < n; i++) {\n    var c = ops[i];\n    if (c === 'p') {\n      stack.push(vals[i]);\n    } else if (c === 'o') {\n      if (stack.length > 0) stack.pop();\n    } else if (c === 't') {\n      out.push(stack.length > 0 ? stack[stack.length - 1] : -1);\n    } else {\n      if (stack.length === 0) {\n        out.push(-1);\n      } else {\n        var smallest = stack[0];\n        for (var j = 1; j < stack.length; j++) {\n          if (stack[j] < smallest) smallest = stack[j];\n        }\n        out.push(smallest);\n      }\n    }\n  }\n  return out;\n}",
