  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(nums) {\n  const n = nums.length;\n  for (let i = 0; i < n; i++) {\n    let left = 0;\n    let right = 0;\n    for (let j = 0; j < i; j++) left += nums[j];\n    for (let j = i + 1; j < n; j++) right += nums[j];\n    if (left === right) return i;\n  }\n  return -1;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(nums) {\n  let total = 0;\n  for (const value of nums) total += value;\n  let left = 0;\n  for (let i = 0; i < nums.length; i++) {\n    if (left === total - left - nums[i]) return i;\n    left += nums[i];\n  }\n  return -1;\n}",
      "isReference": true
    }
