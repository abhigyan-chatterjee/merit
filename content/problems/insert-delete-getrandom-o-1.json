    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(ops) {\n  const slot = new Map();\n  const seq = [];\n  for (let i = 0; i < ops.length; i++) {\n    const step = ops[i];\n    if (step > 0) {\n      if (!slot.has(step)) {\n        slot.set(step, seq.length);\n        seq.push(step);\n      }\n    } else if (step < 0) {\n      const target = -step;\n      if (slot.has(target)) {\n        const at = slot.get(target);\n        const moved = seq[seq.length - 1];\n        seq[at] = moved;\n        slot.set(moved, at);\n        seq.pop();\n        slot.delete(target);\n      }\n    }\n  }\n  return seq;\n}",
      "isReference": true
    }
