      "language": "javascript",
      "code": "function solve(ops) {\n  const seq = [];\n  for (let i = 0; i < ops.length; i++) {\n    const step = ops[i];\n    if (step > 0) {\n      if (seq.indexOf(step) === -1) seq.push(step);\n    } else if (step < 0) {\n      const at = seq.indexOf(-step);\n      if (at !== -1) {\n        seq[at] = seq[seq.length - 1];\n        seq.pop();\n      }\n    }\n  }\n  return seq;\n}",
