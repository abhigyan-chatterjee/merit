    {
      "title": "Brute Force",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(flowerbed, n) {\n  const size = flowerbed.length;\n  const memo = new Map();\n  function best(i, prevOccupied) {\n    if (i === size) return 0;\n    const key = i * 2 + prevOccupied;\n    if (memo.has(key)) return memo.get(key);\n    let result = best(i + 1, flowerbed[i] === 1 ? 1 : 0);\n    const nextFree = i + 1 >= size || flowerbed[i + 1] === 0;\n    if (flowerbed[i] === 0 && prevOccupied === 0 && nextFree) {\n      const planted = 1 + best(i + 1, 1);\n      if (planted > result) result = planted;\n    }\n    memo.set(key, result);\n    return result;\n  }\n  return best(0, 0) >= n;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(flowerbed, n) {\n  const size = flowerbed.length;\n  let planted = 0;\n  let prevOccupied = 0;\n  for (let i = 0; i < size; i++) {\n    if (flowerbed[i] === 1) {\n      prevOccupied = 1;\n      continue;\n    }\n    const nextFree = i + 1 >= size || flowerbed[i + 1] === 0;\n    if (prevOccupied === 0 && nextFree) {\n      planted++;\n      prevOccupied = 1;\n      if (planted >= n) return true;\n    } else {\n      prevOccupied = 0;\n    }\n  }\n  return planted >= n;\n}",
      "isReference": true
    }
