      "complexity": "Time: O(log(m \u00b7 n)) | Space: O(1)",
      "language": "python",
      "code": "def searchMatrix(matrix: list[list[int]], target: int) -> bool:\n    m, n = len(matrix), len(matrix[0])\n    low, high = 0, m * n - 1\n    while low <= high:\n        mid = (low + high) // 2\n        r, c = mid // n, mid % n\n        val = matrix[r][c]\n        if val == target:\n            return True\n        if val < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return False\n",
