      "code": "function searchMatrix(matrix, target) {\n  const m = matrix.length;\n  const n = matrix[0].length;\n  for (let r = 0; r < m; r++) {\n    for (let c = 0; c < n; c++) {\n      if (matrix[r][c] === target) return true;\n    }\n  }\n  return false;\n}",
