    {
      "title": "Brute Force",
      "complexity": "Time: O(numRows\u00b3) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(numRows) {\n  const triangle = [];\n  for (let r = 0; r < numRows; r++) {\n    const row = [];\n    for (let c = 0; c <= r; c++) {\n      let v = 1;\n      for (let i = 0; i < c; i++) {\n        v = (v * (r - i)) / (i + 1);\n      }\n      row.push(v);\n    }\n    triangle.push(row);\n  }\n  return triangle;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(numRows\u00b2) | Space: O(numRows)",
      "language": "javascript",
      "code": "function solve(numRows) {\n  const triangle = [];\n  let row = [1];\n  for (let r = 0; r < numRows; r++) {\n    triangle.push(row.slice());\n    const next = [1];\n    for (let i = 1; i < row.length; i++) {\n      next.push(row[i - 1] + row[i]);\n    }\n    next.push(1);\n    row = next;\n  }\n  return triangle;\n}",
      "isReference": true
    }
