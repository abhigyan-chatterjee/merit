  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n^2) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(nums, target) {\n  const n = nums.length;\n  let first = -1;\n  let last = -1;\n  for (let i = 0; i < n; i++) {\n    if (nums[i] !== target) continue;\n    let rank = 0;\n    for (let j = 0; j < n; j++) {\n      if (nums[j] < target) rank++;\n      else if (nums[j] === target && j < i) rank++;\n    }\n    if (first === -1 || rank < first) first = rank;\n    if (rank > last) last = rank;\n  }\n  return [first, last];\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n log n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums, target) {\n  const ordered = nums.slice().sort((a, b) => a - b);\n  const n = ordered.length;\n  const lowerBound = (value) => {\n    let lo = 0;\n    let hi = n;\n    while (lo < hi) {\n      const mid = (lo + hi) >> 1;\n      if (ordered[mid] < value) lo = mid + 1;\n      else hi = mid;\n    }\n    return lo;\n  };\n  const upperBound = (value) => {\n    let lo = 0;\n    let hi = n;\n    while (lo < hi) {\n      const mid = (lo + hi) >> 1;\n      if (ordered[mid] <= value) lo = mid + 1;\n      else hi = mid;\n    }\n    return lo;\n  };\n  const first = lowerBound(target);\n  if (first === n || ordered[first] !== target) return [-1, -1];\n  return [first, upperBound(target) - 1];\n}",
      "isReference": true
    }
  ],
