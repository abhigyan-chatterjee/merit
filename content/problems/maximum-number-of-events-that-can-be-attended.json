    {
      "title": "Optimal",
      "complexity": "Time: O(n log n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(events) {\n  const evs = [];\n  for (const e of events) {\n    if (!Array.isArray(e) || e.length === 0) continue;\n    evs.push([e[0], e.length > 1 ? e[1] : e[0]]);\n  }\n  const n = evs.length;\n  if (n === 0) return 0;\n  const ordered = evs.slice().sort(function (a, b) { return a[0] - b[0]; });\n  const heap = [];\n\n  function push(x) {\n    heap.push(x);\n    let i = heap.length - 1;\n    while (i > 0) {\n      const p = (i - 1) >> 1;\n      if (heap[p] <= heap[i]) break;\n      const tmp = heap[p];\n      heap[p] = heap[i];\n      heap[i] = tmp;\n      i = p;\n    }\n  }\n\n  function pop() {\n    const top = heap[0];\n    const last = heap.pop();\n    if (heap.length > 0) {\n      heap[0] = last;\n      let i = 0;\n      while (true) {\n        const l = 2 * i + 1;\n        const r = l + 1;\n        let m = i;\n        if (l < heap.length && heap[l] < heap[m]) m = l;\n        if (r < heap.length && heap[r] < heap[m]) m = r;\n        if (m === i) break;\n        const tmp = heap[m];\n        heap[m] = heap[i];\n        heap[i] = tmp;\n        i = m;\n      }\n    }\n    return top;\n  }\n\n  let i = 0;\n  let day = ordered[0][0];\n  let count = 0;\n  while (i < n || heap.length > 0) {\n    if (heap.length === 0 && ordered[i][0] > day) day = ordered[i][0];\n    while (i < n && ordered[i][0] <= day) {\n      push(ordered[i][1]);\n      i++;\n    }\n    while (heap.length > 0 && heap[0] < day) pop();\n    if (heap.length > 0) {\n      pop();\n      count += 1;\n      day += 1;\n    }\n  }\n  return count;\n}\n",
      "isReference": true
