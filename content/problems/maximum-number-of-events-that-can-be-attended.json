      "title": "Brute Force",
      "complexity": "Time: O(D*n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(events) {\n  const evs = [];\n  for (const e of events) {\n    if (!Array.isArray(e) || e.length === 0) continue;\n    evs.push([e[0], e.length > 1 ? e[1] : e[0]]);\n  }\n  const n = evs.length;\n  if (n === 0) return 0;\n  const used = new Array(n).fill(false);\n  let count = 0;\n  let first = evs[0][0];\n  let last = evs[0][1];\n  for (const e of evs) {\n    if (e[0] < first) first = e[0];\n    if (e[1] > last) last = e[1];\n  }\n  for (let day = first; day <= last; day++) {\n    let pick = -1;\n    for (let i = 0; i < n; i++) {\n      if (used[i]) continue;\n      if (evs[i][0] <= day && day <= evs[i][1]) {\n        if (pick === -1 || evs[i][1] < evs[pick][1]) pick = i;\n      }\n    }\n    if (pick !== -1) {\n      used[pick] = true;\n      count += 1;\n    }\n  }\n  return count;\n}\n",
