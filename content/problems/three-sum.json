  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b3) | Space: O(n)",
      "language": "javascript",
      "code": "function threeSum(nums) {\n  const n = nums.length;\n  const seen = new Set();\n  const result = [];\n\n  for (let i = 0; i < n; i++) {\n    for (let j = i + 1; j < n; j++) {\n      for (let k = j + 1; k < n; k++) {\n        if (nums[i] + nums[j] + nums[k] === 0) {\n          const triplet = [nums[i], nums[j], nums[k]].sort((a, b) => a - b);\n          const key = `${triplet[0]},${triplet[1]},${triplet[2]}`;\n          if (!seen.has(key)) {\n            seen.add(key);\n            result.push(triplet);\n          }\n        }\n      }\n    }\n  }\n\n  result.sort((a, b) => a[0] - b[0] || a[1] - b[1] || a[2] - b[2]);\n  return result;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
