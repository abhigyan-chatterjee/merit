    {
      "title": "Optimal",
      "complexity": "Time: O(n log n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(startTime, endTime, profit) {\n  const n = Math.min(startTime.length, endTime.length, profit.length);\n  const jobs = [];\n  for (let i = 0; i < n; i++) {\n    const begin = Math.min(startTime[i], endTime[i]);\n    const finish = Math.max(startTime[i], endTime[i]);\n    jobs.push([finish, begin, i, profit[i]]);\n  }\n  jobs.sort((a, b) => (a[0] - b[0]) || (a[1] - b[1]) || (a[2] - b[2]));\n  const ends = jobs.map((job) => job[0]);\n  const dp = new Array(n + 1).fill(0);\n  for (let i = 1; i <= n; i++) {\n    const begin = jobs[i - 1][1];\n    const pay = jobs[i - 1][3];\n    let lo = 0;\n    let hi = i - 1;\n    while (lo < hi) {\n      const mid = Math.floor((lo + hi + 1) / 2);\n      if (ends[mid - 1] <= begin) lo = mid;\n      else hi = mid - 1;\n    }\n    const take = dp[lo] + pay;\n    dp[i] = take > dp[i - 1] ? take : dp[i - 1];\n  }\n  return dp[n];\n}",
      "isReference": true
    }
