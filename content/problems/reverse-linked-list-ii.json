  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function reverseBetween(nums, left, right) {\n  const arr = nums.slice();\n  const sub = [];\n  for (let i = left - 1; i < right; i++) {\n    sub.push(arr[i]);\n  }\n  sub.reverse();\n  for (let i = left - 1; i < right; i++) {\n    arr[i] = sub[i - (left - 1)];\n  }\n  return arr;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function reverseBetween(nums, left, right) {\n  const result = nums.slice();\n  let l = left - 1;\n  let r = right - 1;\n  while (l < r) {\n    const temp = result[l];\n    result[l] = result[r];\n    result[r] = temp;\n    l++;\n    r--;\n  }\n  return result;\n}",
      "isReference": true
    },
    {
      "title": "Brute Force",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "python",
      "code": "def reverseBetween(nums: list[int], left: int, right: int) -> list[int]:\n    arr = list(nums)\n    sub = arr[left - 1:right]\n    sub.reverse()\n    arr[left - 1:right] = sub\n    return arr\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "python",
      "code": "def reverseBetween(nums: list[int], left: int, right: int) -> list[int]:\n    res = list(nums)\n    l = left - 1\n    r = right - 1\n    while l < r:\n        res[l], res[r] = res[r], res[l]\n        l += 1\n        r -= 1\n    return res\n",
      "isReference": true
    }
  ]
