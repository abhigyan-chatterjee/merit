  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(n)",
      "language": "javascript",
      "code": "function numRescueBoats(people, limit) {\n  const sorted = [...people].sort((a, b) => a - b);\n  const used = new Array(sorted.length).fill(false);\n  let boats = 0;\n\n  for (let i = sorted.length - 1; i >= 0; i--) {\n    if (used[i]) continue;\n    used[i] = true;\n    boats++;\n\n    for (let j = 0; j < i; j++) {\n      if (!used[j] && sorted[i] + sorted[j] <= limit) {\n        used[j] = true;\n        break;\n      }\n    }\n  }\n\n  return boats;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n log n) | Space: O(n)",
      "language": "javascript",
      "code": "function numRescueBoats(people, limit) {\n  const sorted = [...people].sort((a, b) => a - b);\n  let left = 0;\n  let right = sorted.length - 1;\n  let boats = 0;\n\n  while (left <= right) {\n    if (left === right) {\n      boats++;\n      break;\n    }\n    if (sorted[left] + sorted[right] <= limit) {\n      left++;\n    }\n    right--;\n    boats++;\n  }\n\n  return boats;\n}",
      "isReference": true
    },
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(n)",
      "language": "python",
      "code": "def numRescueBoats(people, limit):\n    sorted_people = sorted(people)\n    used = [False] * len(sorted_people)\n    boats = 0\n    for i in range(len(sorted_people) - 1, -1, -1):\n        if used[i]:\n            continue\n        used[i] = True\n        boats += 1\n        for j in range(i):\n            if not used[j] and sorted_people[i] + sorted_people[j] <= limit:\n                used[j] = True\n                break\n    return boats\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n log n) | Space: O(n)",
      "language": "python",
      "code": "def numRescueBoats(people, limit):\n    sorted_people = sorted(people)\n    left = 0\n    right = len(sorted_people) - 1\n    boats = 0\n    while left <= right:\n        if left == right:\n            boats += 1\n            break\n        if sorted_people[left] + sorted_people[right] <= limit:\n            left += 1\n        right -= 1\n        boats += 1\n    return boats\n",
