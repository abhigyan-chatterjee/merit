    {
      "title": "Brute Force",
      "complexity": "Time: O((m + n) log(m + n)) | Space: O(1)",
      "language": "javascript",
      "code": "function merge(nums1, m, nums2, n) {\n  for (let i = 0; i < n; i++) {\n    nums1[m + i] = nums2[i];\n  }\n  nums1.sort((a, b) => a - b);\n  return nums1;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(m + n) | Space: O(1)",
      "language": "javascript",
      "code": "function merge(nums1, m, nums2, n) {\n  let p1 = m - 1;\n  let p2 = n - 1;\n  let p = m + n - 1;\n  while (p2 >= 0) {\n    if (p1 >= 0 && nums1[p1] > nums2[p2]) {\n      nums1[p] = nums1[p1--];\n    } else {\n      nums1[p] = nums2[p2--];\n    }\n    p--;\n  }\n  return nums1;\n}",
      "isReference": true
    },
    {
      "title": "Brute Force",
      "complexity": "Time: O((m + n) log(m + n)) | Space: O(1)",
      "language": "python",
      "code": "def merge(nums1: list[int], m: int, nums2: list[int], n: int) -> list[int]:\n    for i in range(n):\n        nums1[m + i] = nums2[i]\n    nums1.sort()\n    return nums1\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(m + n) | Space: O(1)",
      "language": "python",
      "code": "def merge(nums1: list[int], m: int, nums2: list[int], n: int) -> list[int]:\n    p1 = m - 1\n    p2 = n - 1\n    p = m + n - 1\n    while p2 >= 0:\n        if p1 >= 0 and nums1[p1] > nums2[p2]:\n            nums1[p] = nums1[p1]\n            p1 -= 1\n        else:\n            nums1[p] = nums2[p2]\n            p2 -= 1\n        p -= 1\n    return nums1\n",
      "isReference": true
