    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums, k) {\n  const n = nums.length;\n  if (n === 0) return [];\n  const steps = k % n;\n  const arr = nums.slice();\n\n  function reverse(lo, hi) {\n    while (lo < hi) {\n      const t = arr[lo];\n      arr[lo] = arr[hi];\n      arr[hi] = t;\n      lo++;\n      hi--;\n    }\n  }\n\n  reverse(0, n - 1);\n  reverse(0, steps - 1);\n  reverse(steps, n - 1);\n  return arr;\n}",
      "isReference": true
    }
