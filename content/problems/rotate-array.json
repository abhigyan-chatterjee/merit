      "complexity": "Time: O(n\u00b2) | Space: O(n)",
      "language": "javascript",
      "code": "function solve(nums, k) {\n  const n = nums.length;\n  if (n === 0) return [];\n  const steps = k % n;\n  const arr = nums.slice();\n  for (let s = 0; s < steps; s++) {\n    const last = arr[n - 1];\n    for (let i = n - 1; i > 0; i--) {\n      arr[i] = arr[i - 1];\n    }\n    arr[0] = last;\n  }\n  return arr;\n}",
