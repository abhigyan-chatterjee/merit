  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(n)",
      "language": "javascript",
      "code": "function makeGood(s) {\n  const chars = s.split('');\n  let changed = true;\n  while (changed) {\n    changed = false;\n    for (let i = 0; i < chars.length - 1; i++) {\n      const a = chars[i];\n      const b = chars[i + 1];\n      if (a !== b && a.toLowerCase() === b.toLowerCase()) {\n        chars.splice(i, 2);\n        changed = true;\n        break;\n      }\n    }\n  }\n  return chars.join('');\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function makeGood(s) {\n  const stack = [];\n  for (let i = 0; i < s.length; i++) {\n    const ch = s[i];\n    const top = stack[stack.length - 1];\n    if (stack.length > 0 && top !== ch && top.toLowerCase() === ch.toLowerCase()) {\n      stack.pop();\n    } else {\n      stack.push(ch);\n    }\n  }\n  return stack.join('');\n}",
      "isReference": true
    }
  ],
