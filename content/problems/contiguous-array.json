  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(nums.length^2) | Space: O(1)",
      "language": "javascript",
      "code": "function solve(nums) {\n  const n = nums.length;\n  let best = 0;\n  for (let i = 0; i < n; i++) {\n    let ones = 0;\n    for (let j = i; j < n; j++) {\n      if (nums[j] === 1) ones++;\n      const len = j - i + 1;\n      if (len % 2 === 0 && ones * 2 === len && len > best) best = len;\n    }\n  }\n  return best;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(nums.length) | Space: O(nums.length)",
      "language": "javascript",
      "code": "function solve(nums) {\n  const first = new Map();\n  first.set(0, -1);\n  let balance = 0, best = 0;\n  for (let i = 0; i < nums.length; i++) {\n    balance += nums[i] === 1 ? 1 : -1;\n    if (first.has(balance)) {\n      const len = i - first.get(balance);\n      if (len > best) best = len;\n    } else {\n      first.set(balance, i);\n    }\n  }\n  return best;\n}",
      "isReference": true
    }
  ],
