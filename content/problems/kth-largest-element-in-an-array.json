  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n log n) | Space: O(n)",
      "language": "javascript",
      "code": "function findKthLargest(nums, k) {\n  const sorted = nums.slice().sort((a, b) => a - b);\n  return sorted[sorted.length - k];\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) average | Space: O(1)",
      "language": "javascript",
      "code": "function findKthLargest(nums, k) {\n  const arr = nums.slice();\n  const target = arr.length - k;\n  function swap(i, j) {\n    const t = arr[i];\n    arr[i] = arr[j];\n    arr[j] = t;\n  }\n  let lo = 0;\n  let hi = arr.length - 1;\n  while (lo < hi) {\n    const pivot = arr[(lo + hi) >> 1];\n    let i = lo;\n    let lt = lo;\n    let gt = hi;\n    while (i <= gt) {\n      if (arr[i] < pivot) {\n        swap(i, lt);\n        i++;\n        lt++;\n      } else if (arr[i] > pivot) {\n        swap(i, gt);\n        gt--;\n      } else {\n        i++;\n      }\n    }\n    if (target < lt) hi = lt - 1;\n    else if (target > gt) lo = gt + 1;\n    else return pivot;\n  }\n  return arr[lo];\n}",
      "isReference": true
    },
    {
      "title": "Brute Force",
      "complexity": "Time: O(n log n) | Space: O(n)",
      "language": "python",
      "code": "def findKthLargest(nums, k):\n    ordered = sorted(nums)\n    return ordered[len(ordered) - k]\n",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) average | Space: O(1)",
      "language": "python",
      "code": "def findKthLargest(nums, k):\n    arr = list(nums)\n    target = len(arr) - k\n    lo, hi = 0, len(arr) - 1\n    while lo < hi:\n        pivot = arr[(lo + hi) // 2]\n        i, lt, gt = lo, lo, hi\n        while i <= gt:\n            if arr[i] < pivot:\n                arr[i], arr[lt] = arr[lt], arr[i]\n                i += 1\n                lt += 1\n            elif arr[i] > pivot:\n                arr[i], arr[gt] = arr[gt], arr[i]\n                gt -= 1\n            else:\n                i += 1\n        if target < lt:\n            hi = lt - 1\n        elif target > gt:\n            lo = gt + 1\n        else:\n            return pivot\n    return arr[lo]\n",
      "isReference": true
    }
