  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(n log n) | Space: O(n)",
      "language": "javascript",
      "code": "function levelOrder(root) {\n  const pairs = [];\n  (function dfs(i, d) {\n    if (i >= root.length || root[i] === null) return;\n    pairs.push([d, root[i]]);\n    dfs(2 * i + 1, d + 1);\n    dfs(2 * i + 2, d + 1);\n  })(0, 0);\n  pairs.sort((a, b) => a[0] - b[0]);\n  const levels = [];\n  for (const [d, v] of pairs) {\n    if (!levels[d]) levels[d] = [];\n    levels[d].push(v);\n  }\n  return levels.filter((lv) => lv !== undefined);\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(w)",
      "language": "javascript",
      "code": "function levelOrder(root) {\n  const levels = [];\n  if (root.length === 0 || root[0] === null) return levels;\n  let current = [0];\n  while (current.length > 0) {\n    const next = [];\n    const vals = [];\n    for (const i of current) {\n      vals.push(root[i]);\n      const l = 2 * i + 1;\n      const r = 2 * i + 2;\n      if (l < root.length && root[l] !== null) next.push(l);\n      if (r < root.length && root[r] !== null) next.push(r);\n    }\n    levels.push(vals);\n    current = next;\n  }\n  return levels;\n}",
      "isReference": true
    },
