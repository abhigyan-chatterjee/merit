    {
      "title": "Brute Force",
      "complexity": "Time: O(n\u00b2) | Space: O(n)",
      "language": "javascript",
      "code": "function reorderList(nums) {\n  if (nums.length <= 2) return nums.slice();\n  const queue = nums.slice();\n  const result = [];\n  let fromStart = true;\n  while (queue.length > 0) {\n    if (fromStart) {\n      result.push(queue.shift());\n    } else {\n      result.push(queue.pop());\n    }\n    fromStart = !fromStart;\n  }\n  return result;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(n) | Space: O(n)",
      "language": "javascript",
      "code": "function reorderList(nums) {\n  const n = nums.length;\n  if (n <= 2) return nums.slice();\n  const result = new Array(n);\n  let left = 0;\n  let right = n - 1;\n  let idx = 0;\n  while (left <= right) {\n    if (left === right) {\n      result[idx++] = nums[left++];\n    } else {\n      result[idx++] = nums[left++];\n      result[idx++] = nums[right--];\n    }\n  }\n  return result;\n}",
      "isReference": true
    },
