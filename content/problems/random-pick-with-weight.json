      "title": "Optimal",
      "complexity": "Time: O(n + m log n) | Space: O(n + m)",
      "language": "javascript",
      "code": "function solve(weights, picks) {\n  const n = weights.length;\n  if (n === 0) return picks.map(() => -1);\n  const prefix = [];\n  let total = 0;\n  for (let i = 0; i < n; i++) {\n    total += weights[i];\n    prefix.push(total);\n  }\n  const out = [];\n  for (let q = 0; q < picks.length; q++) {\n    let r = picks[q];\n    if (r < 0) r = 0;\n    if (r > total - 1) r = total - 1;\n    let lo = 0;\n    let hi = n - 1;\n    while (lo < hi) {\n      const mid = Math.floor((lo + hi) / 2);\n      if (prefix[mid] > r) hi = mid;\n      else lo = mid + 1;\n    }\n    out.push(lo);\n  }\n  return out;\n}",
