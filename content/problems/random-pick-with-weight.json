      "language": "javascript",
      "code": "function solve(weights, picks) {\n  const n = weights.length;\n  if (n === 0) return picks.map(() => -1);\n  let total = 0;\n  for (let i = 0; i < n; i++) total += weights[i];\n  const out = [];\n  for (let q = 0; q < picks.length; q++) {\n    let r = picks[q];\n    if (r < 0) r = 0;\n    if (r > total - 1) r = total - 1;\n    let acc = 0;\n    let idx = n - 1;\n    for (let i = 0; i < n; i++) {\n      acc += weights[i];\n      if (acc > r) {\n        idx = i;\n        break;\n      }\n    }\n    out.push(idx);\n  }\n  return out;\n}",
