      "code": "function solve(heights) {\n  const n = heights.length;\n  const res = new Array(n).fill(0);\n  for (let i = 0; i < n; i++) {\n    let mx = -Infinity;\n    for (let j = i + 1; j < n; j++) {\n      if (Math.min(heights[i], heights[j]) >= mx) res[i]++;\n      if (heights[j] > mx) mx = heights[j];\n      if (heights[j] >= heights[i]) break;\n    }\n  }\n  return res;\n}",
