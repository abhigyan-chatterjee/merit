      "code": "function solve(heights) {\n  const n = heights.length;\n  const res = new Array(n).fill(0);\n  const stack = [];\n  for (let i = 0; i < n; i++) {\n    while (stack.length > 0 && heights[stack[stack.length - 1]] <= heights[i]) {\n      res[stack.pop()]++;\n    }\n    if (stack.length > 0) res[stack[stack.length - 1]]++;\n    stack.push(i);\n  }\n  return res;\n}",
