  "solutions": [
    {
      "title": "Brute Force",
      "complexity": "Time: O(P\u00b2 * L) | Space: O(P * L)",
      "language": "javascript",
      "code": "function solve(words) {\n  const found = [];\n  for (const w of words) {\n    for (let len = 1; len <= w.length; len++) {\n      const p = w.slice(0, len);\n      let exists = false;\n      for (const q of found) {\n        if (q === p) {\n          exists = true;\n          break;\n        }\n      }\n      if (!exists) found.push(p);\n    }\n  }\n  return found.length;\n}",
      "isReference": false
    },
    {
      "title": "Optimal",
      "complexity": "Time: O(P) | Space: O(P)",
      "language": "javascript",
      "code": "function solve(words) {\n  const root = new Map();\n  let count = 0;\n  for (const w of words) {\n    let node = root;\n    for (const ch of w) {\n      let next = node.get(ch);\n      if (next === undefined) {\n        next = new Map();\n        node.set(ch, next);\n        count += 1;\n      }\n      node = next;\n    }\n  }\n  return count;\n}",
      "isReference": true
    }
