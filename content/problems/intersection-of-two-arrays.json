      "code": "function solve(nums1, nums2) {\n  const result = [];\n  for (let i = 0; i < nums1.length; i++) {\n    const v = nums1[i];\n    let already = false;\n    for (let k = 0; k < result.length; k++) {\n      if (result[k] === v) already = true;\n    }\n    if (already) continue;\n    let found = false;\n    for (let j = 0; j < nums2.length; j++) {\n      if (nums2[j] === v) {\n        found = true;\n        break;\n      }\n    }\n    if (found) result.push(v);\n  }\n  result.sort((a, b) => a - b);\n  return result;\n}",
