# ==============================================================================
# Algovista API Environment Configuration Template
# Copy this file to .env and configure the variables for your environment.
# ==============================================================================

# Application environment mode (development | production)
ENVIRONMENT=development

# Application name
APP_NAME="Algovista API"

# Database connection URL (SQLite or PostgreSQL)
DATABASE_URL=sqlite:///./algovista.db

# JWT Secret Key (REQUIRED)
# Must be a cryptographically secure random string of at least 32 characters.
# Generate a fresh key by running:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_secure_random_key_here

# JWT Signing Algorithm
ALGORITHM=HS256

# JWT Token Expirations
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional Initial Admin Credentials (used during database seeding: python -m app.seed)
# ADMIN_EMAIL=admin@algovista.org
# ADMIN_PASSWORD=ChangeMe123!
# ADMIN_NAME=Administrator
